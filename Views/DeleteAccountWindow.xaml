<Window
    x:Class="DominoTrainGame.Views.DeleteAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [DeleteAccountWindowTitle]}"
    Width="1220"
    Height="880"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="PasswordField" TargetType="PasswordBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Frost}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{StaticResource Mist}"
                            BorderBrush="{StaticResource Mint}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter
                                    TargetName="FieldBorder"
                                    Property="Background"
                                    Value="{StaticResource Glacier}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfirmationOption" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="OptionBorder"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="2"
                                Background="{StaticResource Mist}">
                                <Path
                                    x:Name="CheckMark"
                                    Visibility="Collapsed"
                                    Fill="{StaticResource Ink}"
                                    RenderOptions.EdgeMode="Aliased"
                                    Data="M3,8 H7 V12 H9 V8 H12 V4 H16 V10 H13 V14 H10 V17 H6 V13 H3 Z" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Text="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                FontSize="16" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="OptionBorder"
                                    Property="Background"
                                    Value="{StaticResource Frost}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="820" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,6,8,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource Glacier}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Path
                                        Fill="{StaticResource Ink}"
                                        Data="M5,5 H11 V11 H5 Z M19,5 H25 V11 H19 Z M0,16 H30 V19 H0 Z
                                            M12,25 H18 V31 H12 Z" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="{Binding [GameTitle]}"
                                Style="{StaticResource PixelText}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Content="{Binding [OpenSettingsButtonLabel]}"
                            Style="{StaticResource PixelButton}"
                            Height="46"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="{Binding [OpenSettingsButtonLabel]}"
                            Click="OpenSettings" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="0,0,4,0">
                                    <Grid ClipToBounds="True">
                                        <StackPanel Margin="24,60,24,0" VerticalAlignment="Top">
                                            <Grid Width="80" Height="88" HorizontalAlignment="Left" Margin="0,0,0,28">
                                                <Path
                                                    Fill="{StaticResource Ink}"
                                                    RenderOptions.EdgeMode="Aliased"
                                                    Data="M24,0 H56 V8 H80 V16 H0 V8 H24 Z
                                                        M8,24 H72 V80 H64 V88 H16 V80 H8 Z" />
                                                <Path
                                                    Fill="{StaticResource Glacier}"
                                                    RenderOptions.EdgeMode="Aliased"
                                                    Data="M16,24 H64 V76 H56 V80 H24 V76 H16 Z" />
                                                <Path
                                                    Fill="{StaticResource Ink}"
                                                    Data="M26,34 H34 V68 H26 Z M46,34 H54 V68 H46 Z" />
                                            </Grid>
                                        </StackPanel>
                                        <Image
                                            Source="/DominoTrainGame/Resources/Images/PixelTrain.png"
                                            Height="242"
                                            Stretch="UniformToFill"
                                            VerticalAlignment="Bottom"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            IsHitTestVisible="False" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1" Margin="36,30,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="96" />
                                        <RowDefinition Height="148" />
                                        <RowDefinition Height="136" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="54" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [DeleteAccountTitle]}"
                                            Style="{StaticResource PixelText}"
                                            FontSize="23" />
                                        <TextBlock
                                            Text="{Binding [DeleteAccountDescription]}"
                                            TextWrapping="Wrap"
                                            Margin="0,18,0,0" />
                                    </StackPanel>
                                    <Border
                                        Grid.Row="1"
                                        Background="{StaticResource Mist}"
                                        BorderBrush="{StaticResource Ink}"
                                        BorderThickness="4,2,2,2"
                                        Padding="20,20"
                                        Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding [DeleteAccountWarningTitle]}"
                                                Style="{StaticResource SectionLabel}"
                                                Margin="0,0,0,14" />
                                            <TextBlock
                                                Text="{Binding [DeleteAccountWarningDescription]}"
                                                TextWrapping="Wrap"
                                                LineHeight="24" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock
                                            Text="{Binding [CurrentPasswordLabel]}"
                                            Style="{StaticResource SectionLabel}"
                                            Margin="0,0,0,10" />
                                        <PasswordBox
                                            x:Name="_currentPasswordBox"
                                            x:FieldModifier="private"
                                            Style="{StaticResource PasswordField}"
                                            AutomationProperties.Name="{Binding [CurrentPasswordLabel]}"
                                            AutomationProperties.HelpText="{Binding [DeleteAccountPasswordHint]}" />
                                        <TextBlock
                                            Text="{Binding [DeleteAccountPasswordHint]}"
                                            TextWrapping="Wrap"
                                            FontSize="14"
                                            Margin="0,12,0,0" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Row="3"
                                        Content="{Binding [DeleteAccountConfirmationLabel]}"
                                        Style="{StaticResource ConfirmationOption}"
                                        VerticalAlignment="Top"
                                        Margin="0,8,0,24"
                                        AutomationProperties.Name="{Binding [DeleteAccountConfirmationLabel]}" />
                                    <Grid Grid.Row="4">
                                        <Button
                                            Content="{Binding [CancelButtonLabel]}"
                                            Style="{StaticResource PixelButton}"
                                            Width="170"
                                            HorizontalAlignment="Left"
                                            IsCancel="True"
                                            Click="GoBack" />
                                        <Button
                                            Content="{Binding [DeleteAccountTitle]}"
                                            Style="{StaticResource PixelButton}"
                                            Background="{StaticResource Ink}"
                                            Foreground="{StaticResource Glacier}"
                                            Width="268"
                                            HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        Text="{Binding [PasswordPrivacyNote]}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Margin="0,0,8,0" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DominoTrainGame.Client.View.Views.MessageWindow"
    Title="{Binding [GameTitle], Source={StaticResource Localization}}"
    Width="560"
    SizeToContent="Height"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    MouseLeftButtonDown="OnWindowMouseLeftButtonDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="MessageButtonsVisibility" />
        <Style x:Key="AccentBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Aqua}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConfirmation}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Amber}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid TextOptions.TextFormattingMode="Display">
        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
        <Border
            Margin="0,0,8,8"
            Background="{StaticResource Glacier}"
            BorderBrush="{StaticResource Ink}"
            BorderThickness="4">
            <StackPanel>
                <Border
                    Height="16"
                    BorderBrush="{StaticResource Ink}"
                    BorderThickness="0,0,0,4"
                    Style="{StaticResource AccentBorderStyle}" />
                <StackPanel Margin="32,24,32,28">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle
                            Width="40"
                            Height="46"
                            Margin="0,0,16,0"
                            Fill="{StaticResource MiniDominoBrush}"
                            Style="{StaticResource PixelArtStyle}" />
                        <TextBlock
                            Text="{Binding Heading}"
                            Style="{StaticResource PixelTextStyle}"
                            FontSize="15"
                            MaxWidth="400"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding Message}"
                        Margin="0,22,0,28"
                        TextWrapping="Wrap"
                        LineHeight="24" />
                    <Button
                        Content="{Binding [AcceptButtonLabel], Source={StaticResource Localization}}"
                        Style="{StaticResource PixelButtonStyle}"
                        Background="{StaticResource Aqua}"
                        MinWidth="150"
                        HorizontalAlignment="Right"
                        IsDefault="{Binding IsAcknowledgement}"
                        IsCancel="{Binding IsAcknowledgement}"
                        Visibility="{Binding IsAcknowledgement,
                            Converter={StaticResource MessageButtonsVisibility}}" />
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsConfirmation,
                            Converter={StaticResource MessageButtonsVisibility}}">
                        <Button
                            Content="{Binding [NoButtonLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource PixelButtonStyle}"
                            MinWidth="130"
                            Margin="0,0,16,0"
                            IsCancel="{Binding IsConfirmation}" />
                        <Button
                            Content="{Binding [YesButtonLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource PixelButtonStyle}"
                            Background="{StaticResource Aqua}"
                            MinWidth="130"
                            IsDefault="{Binding IsConfirmation}"
                            Click="OnYesButtonClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

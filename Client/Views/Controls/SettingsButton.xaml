<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    x:Class="DominoTrainGame.Client.View.Views.Controls.SettingsButton">
    <Button
        Style="{StaticResource MenuIconButtonStyle}"
        Command="{Binding DataContext.SettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        ToolTip="{Binding [SettingsLabel], Source={StaticResource Localization}}">
        <Rectangle
            Width="36"
            Height="36"
            Fill="{StaticResource MenuSettingsBrush}"
            Style="{StaticResource PixelArtStyle}" />
    </Button>
</UserControl>

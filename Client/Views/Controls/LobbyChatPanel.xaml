<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Class="DominoTrainGame.Client.View.Views.Controls.LobbyChatPanel">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ChatNoticeVisibility" />
    </UserControl.Resources>
    <Border
        Background="{StaticResource ChatPanelBackground}"
        BorderBrush="{StaticResource NightBorder}"
        BorderThickness="2"
        Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                x:Name="ChatScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                ScrollChanged="OnChatScrollViewerScrollChanged">
                <ItemsControl
                    ItemsSource="{Binding Messages}"
                    VerticalAlignment="Bottom">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock
                                    Text="{Binding SenderUsername}"
                                    Style="{StaticResource PixelTextDarkStyle}"
                                    Foreground="{StaticResource Mist}"
                                    FontSize="8" />
                                <TextBlock
                                    Text="{Binding Text}"
                                    Style="{StaticResource MatchBodyStyle}"
                                    Foreground="{StaticResource NightText}"
                                    FontSize="14"
                                    LineHeight="20"
                                    Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="8,6"
                Background="#B33A3A"
                BorderBrush="{StaticResource NightBorder}"
                BorderThickness="1"
                Visibility="{Binding HasChatNotice,
                    Converter={StaticResource ChatNoticeVisibility}}">
                <TextBlock
                    Text="{Binding ChatNotice}"
                    Style="{StaticResource MatchBodyStyle}"
                    Foreground="{StaticResource NightText}"
                    FontSize="12"
                    TextWrapping="Wrap" />
            </Border>
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Style="{StaticResource NightTextBoxStyle}"
                    Background="{StaticResource ChatInputBackground}"
                    Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                    MaxLength="{Binding MaximumMessageLength, Mode=OneTime}"
                    AutomationProperties.Name="{Binding [RoomChatLabel],
                        Source={StaticResource Localization}}">
                    <TextBox.InputBindings>
                        <KeyBinding
                            Key="Return"
                            Command="{Binding SendMessageCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock
                    Text="{Binding [ChatMessagePlaceholder],
                        Source={StaticResource Localization}}"
                    Foreground="{StaticResource Mint}"
                    FontFamily="Consolas"
                    FontSize="15"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding MessageText}"
                                    Value="{x:Static sys:String.Empty}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource PixelIconButtonStyle}"
                    Command="{Binding SendMessageCommand}"
                    Width="48"
                    Height="48"
                    Margin="6,0,0,0"
                    ToolTip="{Binding [SendMessageButtonLabel],
                        Source={StaticResource Localization}}"
                    AutomationProperties.Name="{Binding [SendMessageButtonLabel],
                        Source={StaticResource Localization}}">
                    <Rectangle
                        Width="22"
                        Height="18"
                        Fill="{StaticResource ChatSendBrush}"
                        Style="{StaticResource PixelArtStyle}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>

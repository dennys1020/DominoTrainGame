<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    x:Class="DominoTrainGame.Client.View.Views.ChangePasswordWindow"
    Title="{Binding [ChangePasswordLabel], Source={StaticResource Localization}}"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    FocusManager.FocusedElement="{Binding ElementName=CurrentPasswordBox}"
    Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="PasswordFieldStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Frost}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{StaticResource Mist}"
                            BorderBrush="{StaticResource Mint}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter
                                    TargetName="FieldBorder"
                                    Property="Background"
                                    Value="{StaticResource Glacier}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PasswordLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionLabelStyle}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewboxStyle}">
            <Grid Width="1200" Height="820" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,6,8,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Rectangle
                                    Margin="0,0,0,0"
                                    Fill="{StaticResource MiniDominoBrush}"
                                    Style="{StaticResource PixelArtStyle}" />
                            </Grid>
                            <TextBlock
                                Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Content="{Binding [SettingsLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource PixelButtonStyle}"
                            Height="46"
                            HorizontalAlignment="Right"
                            Command="{Binding DataContext.SettingsCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="0,0,4,0" />
                                <Rectangle
                                    Margin="0,364,0,0"
                                    Fill="{StaticResource PixelTrainBrush}"
                                    Style="{StaticResource PixelArtStyle}" />
                                <Grid Margin="10,52,159,470">
                                    <Rectangle
                                        Fill="{StaticResource LockBrush}"
                                        Style="{StaticResource PixelArtStyle}" />
                                </Grid>
                                <Grid Grid.Column="1" Margin="36,30,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="96" />
                                        <RowDefinition Height="288" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="54" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [ChangePasswordLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelTextStyle}"
                                            FontSize="23" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock
                                            Text="{Binding [CurrentPasswordLabel],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource PasswordLabelStyle}" />
                                        <PasswordBox
                                            x:Name="CurrentPasswordBox"
                                            x:FieldModifier="private"
                                            Style="{StaticResource PasswordFieldStyle}"
                                            Margin="0,0,0,24" />
                                        <TextBlock
                                            Text="{Binding [NewPasswordLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource PasswordLabelStyle}" />
                                        <PasswordBox Style="{StaticResource PasswordFieldStyle}" Margin="0,0,0,24" />
                                        <TextBlock
                                            Text="{Binding [ConfirmPasswordLabel],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource PasswordLabelStyle}" />
                                        <PasswordBox Style="{StaticResource PasswordFieldStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,4,0,16">
                                        <TextBlock
                                            Text="{Binding [NewPasswordHint], Source={StaticResource Localization}}"
                                            TextWrapping="Wrap"
                                            FontSize="14" />
                                    </StackPanel>
                                    <Grid Grid.Row="3">
                                        <Button
                                            Content="{Binding [BackButtonLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelButtonStyle}"
                                            Width="154"
                                            HorizontalAlignment="Left"
                                            IsCancel="True"
                                            Command="{Binding DataContext.CloseCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button
                                            Content="{Binding [ChangePasswordLabel],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelButtonStyle}"
                                            Background="{StaticResource Ink}"
                                            Foreground="{StaticResource Glacier}"
                                            Width="300"
                                            HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        Text="{Binding [PasswordPrivacyNote], Source={StaticResource Localization}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Margin="0,0,8,0" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

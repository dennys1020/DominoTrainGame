<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    x:Class="DominoTrainGame.Client.View.Views.RecoverPasswordWindow"
    Title="{Binding [RecoverPasswordTitle], Source={StaticResource Localization}}"
    Width="460"
    Height="480"
    MinWidth="380"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="StepVisibility" />
    </Window.Resources>
    <Grid Background="{StaticResource Mist}">
        <Viewbox Style="{StaticResource DialogViewboxStyle}">
            <Grid Width="460">
                <Grid Margin="24">
                    <Border
                        Background="{StaticResource Glacier}"
                        BorderBrush="{StaticResource Ink}"
                        BorderThickness="2"
                        Padding="20">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,1,0">
                            <TextBlock
                                Text="{Binding [RecoverPasswordTitle], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20" />
                            <StackPanel
                                Visibility="{Binding IsIdentifyStep, Converter={StaticResource StepVisibility}}">
                                <TextBlock
                                    Text="{Binding [EmailOrUsernameLabel], Source={StaticResource Localization}}"
                                    Style="{StaticResource SectionLabelStyle}"
                                    Margin="0,0,0,4" />
                                <TextBox
                                    Text="{Binding Identifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Height="36"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Padding="8"
                                    Margin="0,0,0,20" />
                                <Button
                                    Content="{Binding [SendCodeButtonLabel], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelButtonStyle}"
                                    Height="50"
                                    Width="253"
                                    Command="{Binding DataContext.SendCodeCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <StackPanel
                                Visibility="{Binding IsPasswordStep, Converter={StaticResource StepVisibility}}">
                                <TextBlock
                                    Text="{Binding [NewPasswordLabel], Source={StaticResource Localization}}"
                                    Style="{StaticResource SectionLabelStyle}"
                                    Margin="0,0,0,4" />
                                <PasswordBox
                                    Height="36"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Padding="8"
                                    Margin="0,0,0,16" />
                                <TextBlock
                                    Text="{Binding [ConfirmPasswordLabel], Source={StaticResource Localization}}"
                                    Style="{StaticResource SectionLabelStyle}"
                                    Margin="0,0,0,4" />
                                <PasswordBox
                                    Height="36"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Padding="8"
                                    Margin="0,0,0,20" />
                                <Button
                                    Content="{Binding [ChangePasswordLabel], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelButtonStyle}"
                                    Height="50"
                                    Width="253"
                                    Command="{Binding DataContext.UpdatePasswordCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Message}"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Margin="0,16,0,0"
                                AutomationProperties.LiveSetting="Polite" />
                            <Button
                                Content="{Binding [CancelButtonLabel], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelButtonStyle}"
                                Height="50"
                                Width="253"
                                Padding="8"
                                Margin="0,18,0,0"
                                Command="{Binding DataContext.CancelCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DominoTrainGame.Client.View.Views.Controls"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="DominoTrainGame.Client.View.Views.RoomWindow"
    Title="{Binding [RoomTitle], Source={StaticResource Localization}}"
    Style="{StaticResource MatchWindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="HostVisibility" />
        <BooleanToVisibilityConverter x:Key="ChatNoticeVisibility" />
        <Style x:Key="ReadyButtonStyle" TargetType="Button" BasedOn="{StaticResource MatchButtonStyle}">
            <Setter
                Property="Command"
                Value="{Binding DataContext.ToggleReadyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Content" Value="{Binding [MarkReadyButtonLabel], Source={StaticResource Localization}}" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentPlayer}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReady}" Value="True">
                    <Setter
                        Property="Content"
                        Value="{Binding [CancelReadyButtonLabel], Source={StaticResource Localization}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InviteFriendsButtonStyle" TargetType="Button" BasedOn="{StaticResource MatchButtonStyle}">
            <Setter Property="Command" Value="{Binding OpenCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InviteFriendItemButtonStyle" TargetType="Button" BasedOn="{StaticResource MatchButtonStyle}">
            <Setter Property="Command" Value="{Binding InviteCommand}" />
            <Setter
                Property="Content"
                Value="{Binding [InviteFriendButtonLabel], Source={StaticResource Localization}}" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInvited}" Value="True">
                    <Setter
                        Property="Content"
                        Value="{Binding [InvitedFriendLabel], Source={StaticResource Localization}}" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvitableFriendNameStyle" TargetType="TextBlock" BasedOn="{StaticResource MatchBodyStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="NoFriendsToInviteStyle" TargetType="TextBlock" BasedOn="{StaticResource MatchBodyStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Friends.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="InvitableFriendTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Username}" Style="{StaticResource InvitableFriendNameStyle}" />
                <Button Grid.Column="1" Style="{StaticResource InviteFriendItemButtonStyle}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewboxStyle}">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle
                                Width="24"
                                Height="42"
                                Margin="0,0,16,0"
                                Fill="{StaticResource MatchDominoBrush}"
                                Style="{StaticResource PixelArtStyle}" />
                            <TextBlock
                                Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:SettingsButton HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCardStyle}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="68" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding [RoomTitle], Source={StaticResource Localization}}"
                                        Style="{StaticResource MatchHeadingStyle}" />
                                    <TextBlock
                                        Text="{Binding [ReconnectingMessage], Source={StaticResource Localization}}"
                                        Style="{StaticResource PixelTextStyle}"
                                        FontSize="14"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding IsReconnecting,
                                            Converter={StaticResource HostVisibility}}" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="370" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel
                                            Visibility="{Binding DataContext.IsHost,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource HostVisibility}}"
                                            d:Visibility="Visible">
                                            <TextBlock
                                                Text="{Binding [RoomCodeLabel], Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchSectionStyle}" />
                                            <Border
                                                Background="{StaticResource Frost}"
                                                BorderBrush="{StaticResource Ink}"
                                                BorderThickness="2"
                                                Padding="18,19">
                                                <TextBlock
                                                    Text="{Binding LobbyCode}"
                                                    Style="{StaticResource PixelTextStyle}"
                                                    FontSize="26"
                                                    HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock
                                                Text="{Binding [RoomCodeDescription],
                                                    Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchBodyStyle}"
                                                Margin="0,10,0,24"
                                                FontSize="16" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding [MaximumDoubleLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource MatchSectionStyle}" />
                                        <UniformGrid
                                            Rows="1"
                                            Visibility="{Binding DataContext.IsHost,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource HostVisibility}}"
                                            IsEnabled="{Binding DataContext.IsHost,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            d:Visibility="Visible"
                                            d:IsEnabled="True">
                                            <RadioButton
                                                Content="{Binding [DoubleSixOptionLabel],
                                                    Source={StaticResource Localization}}"
                                                GroupName="MaximumDouble"
                                                Style="{StaticResource MatchDoubleOptionStyle}"
                                                Margin="0,0,10,0"
                                                FontSize="20"
                                                Padding="18,20"
                                                IsChecked="{Binding DataContext.Room.IsDoubleSixSelected,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Mode=TwoWay}"
                                                d:IsChecked="False" />
                                            <RadioButton
                                                Content="{Binding [DoubleNineOptionLabel],
                                                    Source={StaticResource Localization}}"
                                                GroupName="MaximumDouble"
                                                Style="{StaticResource MatchDoubleOptionStyle}"
                                                Margin="0,0,10,0"
                                                FontSize="20"
                                                Padding="18,20"
                                                IsChecked="{Binding DataContext.Room.IsDoubleNineSelected,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Mode=TwoWay}"
                                                d:IsChecked="False" />
                                            <RadioButton
                                                Content="{Binding [DoubleTwelveOptionLabel],
                                                    Source={StaticResource Localization}}"
                                                GroupName="MaximumDouble"
                                                Style="{StaticResource MatchDoubleOptionStyle}"
                                                Margin="0,0,10,0"
                                                FontSize="20"
                                                Padding="18,20"
                                                IsChecked="{Binding DataContext.Room.IsDoubleTwelveSelected,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Mode=TwoWay}"
                                                d:IsChecked="True" />
                                        </UniformGrid>
                                        <Border
                                            Background="{StaticResource Mist}"
                                            Padding="18,20"
                                            d:Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding DataContext.IsHost,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock
                                                    Text="{Binding DataContext.Room.MaximumDouble,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource PixelTextStyle}"
                                                    FontSize="24"
                                                    HorizontalAlignment="Center" />
                                                <TextBlock
                                                    Text="{Binding [MaximumDoubleReadOnlyDescription],
                                                        Source={StaticResource Localization}}"
                                                    Style="{StaticResource MatchBodyStyle}"
                                                    Margin="0,12,0,0"
                                                    FontSize="16"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock
                                            Text="{Binding [MaximumDoubleDescription],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource MatchBodyStyle}"
                                            Margin="0,12,0,0"
                                            FontSize="16" />
                                    </StackPanel>
                                    <Grid
                                        Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Text="{Binding [PlayersLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource MatchSectionStyle}" />
                                        <TextBlock
                                            Style="{StaticResource PixelTextStyle}"
                                            HorizontalAlignment="Right"
                                            FontSize="13">
                                            <TextBlock.Text>
                                                <MultiBinding
                                                    StringFormat="{x:Static strings:UiStrings.RoomPlayerCountFormat}">
                                                    <Binding Path="Players.Count" />
                                                    <Binding Path="MaximumPlayers" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <ScrollViewer
                                            Grid.Row="1"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ItemsControl ItemsSource="{Binding Players}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            BorderBrush="{StaticResource Mint}"
                                                            BorderThickness="0,0,0,2"
                                                            Padding="12,10">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter
                                                                        Property="Background"
                                                                        Value="{StaticResource Glacier}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding IsCurrentPlayer}"
                                                                            Value="True">
                                                                            <Setter
                                                                                Property="Background"
                                                                                Value="{StaticResource Mist}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid MinHeight="52">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Rectangle
                                                                    Width="30"
                                                                    Height="34"
                                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                    HorizontalAlignment="Left"
                                                                    Fill="{StaticResource DefaultAvatarBrush}"
                                                                    Style="{StaticResource PixelArtStyle}" />
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,12,0">
                                                                    <TextBlock
                                                                        ToolTip="{Binding Username}"
                                                                        FontSize="19">
                                                                        <TextBlock.Style>
                                                                            <Style
                                                                                TargetType="TextBlock"
                                                                                BasedOn="{StaticResource
                                                                                    MatchBodyStyle}">
                                                                                <Setter
                                                                                    Property="Text"
                                                                                    Value="{Binding Username}" />
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition
                                                                                                Binding="{Binding
                                                                                                    IsCurrentPlayer}"
                                                                                                Value="True" />
                                                                                            <Condition
                                                                                                Binding="{Binding
                                                                                                    Username}"
                                                                                                Value="" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter
                                                                                            Property="Text"
                                                                                            Value="{Binding
                                                                                                [YouPlayerLabel],
                                                                                                Source={StaticResource
                                                                                                    Localization}}" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock
                                                                        Text="{Binding [RoomHostLabel],
                                                                            Source={StaticResource Localization}}">
                                                                        <TextBlock.Style>
                                                                            <Style
                                                                                TargetType="TextBlock"
                                                                                BasedOn="{StaticResource
                                                                                    PixelTextStyle}">
                                                                                <Setter Property="FontSize" Value="9" />
                                                                                <Setter
                                                                                    Property="Margin"
                                                                                    Value="0,6,0,0" />
                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsHost}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Visibility"
                                                                                            Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Right"
                                                                        Margin="0,0,0,6">
                                                                        <TextBlock.Style>
                                                                            <Style
                                                                                TargetType="TextBlock"
                                                                                BasedOn="{StaticResource
                                                                                    PixelTextStyle}">
                                                                                <Setter Property="FontSize" Value="9" />
                                                                                <Setter
                                                                                    Property="Text"
                                                                                    Value="{Binding [RoomNotReadyLabel],
                                                                                        Source={StaticResource
                                                                                            Localization}}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsReady}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Text"
                                                                                            Value="{Binding
                                                                                                [ReadyStatusLabel],
                                                                                                Source={StaticResource
                                                                                                    Localization}}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button
                                                                        Style="{StaticResource ReadyButtonStyle}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Border
                                            Grid.Row="1"
                                            Background="{StaticResource Mist}"
                                            Padding="20"
                                            VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Players.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                Text="{Binding [RoomNoPlayersLabel],
                                                    Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchBodyStyle}"
                                                FontSize="16" />
                                        </Border>
                                    </Grid>
                                    <Border
                                        Grid.Column="4"
                                        Height="240"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource ChatPanelBackground}"
                                        BorderBrush="{StaticResource NightBorder}"
                                        BorderThickness="2"
                                        Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ScrollViewer
                                                x:Name="ChatScrollViewer"
                                                VerticalScrollBarVisibility="Auto"
                                                HorizontalScrollBarVisibility="Disabled"
                                                ScrollChanged="OnChatScrollViewerScrollChanged">
                                                <ItemsControl
                                                    ItemsSource="{Binding Messages}"
                                                    VerticalAlignment="Bottom">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,8">
                                                                <TextBlock
                                                                    Text="{Binding SenderUsername}"
                                                                    Style="{StaticResource PixelTextDarkStyle}"
                                                                    Foreground="{StaticResource Mist}"
                                                                    FontSize="8" />
                                                                <TextBlock
                                                                    Text="{Binding Text}"
                                                                    Style="{StaticResource MatchBodyStyle}"
                                                                    Foreground="{StaticResource NightText}"
                                                                    FontSize="14"
                                                                    LineHeight="20"
                                                                    Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <Border
                                                Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Padding="8,6"
                                                Background="#B33A3A"
                                                BorderBrush="{StaticResource NightBorder}"
                                                BorderThickness="1"
                                                Visibility="{Binding HasChatNotice,
                                                    Converter={StaticResource ChatNoticeVisibility}}">
                                                <TextBlock
                                                    Text="{Binding ChatNotice}"
                                                    Style="{StaticResource MatchBodyStyle}"
                                                    Foreground="{StaticResource NightText}"
                                                    FontSize="12"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Style="{StaticResource NightTextBoxStyle}"
                                                    Background="{StaticResource ChatInputBackground}"
                                                    Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                                    MaxLength="{Binding MaximumMessageLength, Mode=OneTime}"
                                                    AutomationProperties.Name="{Binding [RoomChatLabel],
                                                        Source={StaticResource Localization}}">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding
                                                            Key="Return"
                                                            Command="{Binding SendMessageCommand}" />
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <TextBlock
                                                    Text="{Binding [ChatMessagePlaceholder],
                                                        Source={StaticResource Localization}}"
                                                    Foreground="{StaticResource Mint}"
                                                    FontFamily="Consolas"
                                                    FontSize="15"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding MessageText}"
                                                                    Value="{x:Static sys:String.Empty}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button
                                                    Grid.Column="1"
                                                    Style="{StaticResource PixelIconButtonStyle}"
                                                    Command="{Binding SendMessageCommand}"
                                                    Width="48"
                                                    Height="48"
                                                    Margin="6,0,0,0"
                                                    ToolTip="{Binding [SendMessageButtonLabel],
                                                        Source={StaticResource Localization}}"
                                                    AutomationProperties.Name="{Binding [SendMessageButtonLabel],
                                                        Source={StaticResource Localization}}">
                                                    <Rectangle
                                                        Width="22"
                                                        Height="18"
                                                        Fill="{StaticResource ChatSendBrush}"
                                                        Style="{StaticResource PixelArtStyle}" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid
                                        DataContext="{Binding InviteFriends}"
                                        IsEnabled="{Binding IsIdle}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                        <Button
                                            Content="{Binding [InviteFriendsButtonLabel],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource InviteFriendsButtonStyle}"
                                            MinWidth="270" />
                                        <Popup
                                            IsOpen="{Binding IsOpen, Mode=TwoWay}"
                                            StaysOpen="False"
                                            Placement="Top"
                                            VerticalOffset="-8">
                                            <Border
                                                Width="380"
                                                Background="{StaticResource Glacier}"
                                                BorderBrush="{StaticResource Ink}"
                                                BorderThickness="3"
                                                Padding="16">
                                                <StackPanel>
                                                    <TextBlock
                                                        Text="{Binding [InviteFriendsButtonLabel],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchSectionStyle}" />
                                                    <ScrollViewer
                                                        MaxHeight="260"
                                                        VerticalScrollBarVisibility="Auto"
                                                        HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl
                                                            ItemsSource="{Binding Friends}"
                                                            ItemTemplate="{StaticResource InvitableFriendTemplate}" />
                                                    </ScrollViewer>
                                                    <TextBlock
                                                        Text="{Binding [NoFriendsToInviteLabel],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource NoFriendsToInviteStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button
                                        Content="{Binding [StartMatchButtonLabel],
                                            Source={StaticResource Localization}}"
                                        Style="{StaticResource MatchButtonStyle}"
                                        Command="{Binding DataContext.StartMatchCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Right"
                                        Width="270"
                                        Background="{StaticResource Aqua}"
                                        Visibility="{Binding DataContext.IsHost,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource HostVisibility}}"
                                        IsEnabled="{Binding DataContext.CanStartMatch,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        d:Visibility="Visible"
                                        d:IsEnabled="True" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,8,4">
                        <Button
                            Content="{Binding [BackButtonLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource MatchButtonStyle}"
                            Command="{Binding DataContext.BackCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Left"
                            MinWidth="170" />
                        <Button
                            Content="{Binding [GameRulesTitle], Source={StaticResource Localization}}"
                            Style="{StaticResource MatchButtonStyle}"
                            Command="{Binding DataContext.RulesCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Right"
                            MinWidth="210" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    xmlns:controls="clr-namespace:DominoTrainGame.Client.View.Views.Controls"
    x:Class="DominoTrainGame.Client.View.Views.JoinGameWindow"
    Title="{Binding [InvitationTitle], Source={StaticResource Localization}}"
    Style="{StaticResource MatchWindowStyle}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewboxStyle}">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle
                                Width="24"
                                Height="42"
                                Margin="0,0,16,0"
                                Fill="{StaticResource MatchDominoBrush}"
                                Style="{StaticResource PixelArtStyle}" />
                            <TextBlock
                                Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:SettingsButton HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCardStyle}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="2"
                                    Padding="28">
                                    <StackPanel VerticalAlignment="Center">
                                        <Rectangle
                                            Width="78"
                                            Height="138"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,36"
                                            Fill="{StaticResource MatchDominoBrush}"
                                            Style="{StaticResource PixelArtStyle}" />
                                        <TextBlock
                                            Text="{Binding [JoinSidebarTitle], Source={StaticResource Localization}}"
                                            Style="{StaticResource MatchHeadingStyle}"
                                            FontSize="19" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Column="1" Margin="40,20,12,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="60" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [InvitationTitle], Source={StaticResource Localization}}"
                                            Style="{StaticResource MatchHeadingStyle}" />
                                        <TextBlock
                                            Text="{Binding [InvitationDescription],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource MatchBodyStyle}"
                                            Margin="0,18,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,26,0,26">
                                        <TextBlock
                                            Text="{Binding [RoomCodeLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource MatchSectionStyle}" />
                                        <TextBox
                                            Style="{StaticResource MatchInputStyle}"
                                            MinHeight="82"
                                            AutomationProperties.Name="{Binding [RoomCodeLabel],
                                                Source={StaticResource Localization}}"
                                            ToolTip="{Binding [InvitationCodeHint],
                                                Source={StaticResource Localization}}" />
                                    </StackPanel>
                                    <Button
                                        Content="{Binding [JoinRoomButtonLabel], Source={StaticResource Localization}}"
                                        Style="{StaticResource MatchButtonStyle}"
                                        Command="{Binding DataContext.RoomCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        Grid.Row="2"
                                        Background="{StaticResource Aqua}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,8,4">
                        <Button
                            Content="{Binding [BackButtonLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource MatchButtonStyle}"
                            Command="{Binding DataContext.BackCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Left"
                            MinWidth="170" />
                        <Button
                            Content="{Binding [GameRulesTitle], Source={StaticResource Localization}}"
                            Style="{StaticResource MatchButtonStyle}"
                            Command="{Binding DataContext.RulesCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Right"
                            MinWidth="210" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

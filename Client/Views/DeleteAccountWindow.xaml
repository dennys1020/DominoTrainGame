<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    x:Class="DominoTrainGame.Client.View.Views.DeleteAccountWindow"
    Title="{Binding [DeleteAccountTitle], Source={StaticResource Localization}}"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="PasswordFieldStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Frost}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{StaticResource Mist}"
                            BorderBrush="{StaticResource Mint}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter
                                    TargetName="FieldBorder"
                                    Property="Background"
                                    Value="{StaticResource Glacier}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfirmationOptionStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="OptionBorder"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="2"
                                Background="{StaticResource Mist}">
                                <Rectangle
                                    x:Name="CheckMarkRectangle"
                                    Visibility="Collapsed"
                                    RenderOptions.EdgeMode="Aliased"
                                    Fill="{StaticResource CheckBrush}"
                                    Style="{StaticResource PixelArtStyle}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Text="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                FontSize="16" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMarkRectangle" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="OptionBorder"
                                    Property="Background"
                                    Value="{StaticResource Frost}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OptionBorder" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewboxStyle}">
            <Grid Width="1200" Height="820" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,6,8,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Rectangle
                                    Fill="{StaticResource MiniDominoBrush}"
                                    Style="{StaticResource PixelArtStyle}" />
                            </Grid>
                            <TextBlock
                                Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Content="{Binding [SettingsLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource PixelButtonStyle}"
                            Height="46"
                            HorizontalAlignment="Right"
                            Command="{Binding DataContext.SettingsCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="0,0,4,0">
                                    <Rectangle
                                        Margin="0,364,0,0"
                                        Fill="{StaticResource PixelTrainBrush}"
                                        Style="{StaticResource PixelArtStyle}" />
                                </Border>
                                <Grid Grid.Column="1" Margin="36,30,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="96" />
                                        <RowDefinition Height="148" />
                                        <RowDefinition Height="136" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="54" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [DeleteAccountTitle], Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelTextStyle}"
                                            FontSize="23" />
                                        <TextBlock
                                            Text="{Binding [DeleteAccountDescription],
                                                Source={StaticResource Localization}}"
                                            TextWrapping="Wrap"
                                            Margin="0,18,0,0" />
                                    </StackPanel>
                                    <Border
                                        Grid.Row="1"
                                        Background="{StaticResource Mist}"
                                        BorderBrush="{StaticResource Ink}"
                                        BorderThickness="4,2,2,2"
                                        Padding="20,20"
                                        Margin="0,0,0,24">
                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding [DeleteAccountWarningTitle],
                                                    Source={StaticResource Localization}}"
                                                Style="{StaticResource SectionLabelStyle}"
                                                Margin="0,0,0,14" />
                                            <TextBlock
                                                Text="{Binding [DeleteAccountWarningDescription],
                                                    Source={StaticResource Localization}}"
                                                TextWrapping="Wrap"
                                                LineHeight="24" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock
                                            Text="{Binding [CurrentPasswordLabel],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource SectionLabelStyle}"
                                            Margin="0,0,0,10" />
                                        <PasswordBox
                                            Style="{StaticResource PasswordFieldStyle}" />
                                        <TextBlock
                                            Text="{Binding [DeleteAccountPasswordHint],
                                                Source={StaticResource Localization}}"
                                            TextWrapping="Wrap"
                                            FontSize="14"
                                            Margin="0,12,0,0" />
                                    </StackPanel>
                                    <CheckBox
                                        Grid.Row="3"
                                        Content="{Binding [DeleteAccountConfirmationLabel],
                                            Source={StaticResource Localization}}"
                                        Style="{StaticResource ConfirmationOptionStyle}"
                                        VerticalAlignment="Top"
                                        Margin="0,8,0,24" />
                                    <Grid Grid.Row="4">
                                        <Button
                                            Content="{Binding [CancelButtonLabel],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelButtonStyle}"
                                            Width="170"
                                            HorizontalAlignment="Left"
                                            IsCancel="True"
                                            Command="{Binding DataContext.CloseCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button
                                            Content="{Binding [DeleteAccountTitle],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelButtonStyle}"
                                            Background="{StaticResource Ink}"
                                            Foreground="{StaticResource Glacier}"
                                            Width="268"
                                            HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        Text="{Binding [PasswordPrivacyNote], Source={StaticResource Localization}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Margin="0,0,8,0" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

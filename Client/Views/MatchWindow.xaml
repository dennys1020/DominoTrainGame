<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="DominoTrainGame.Client.View.Views.MatchWindow"
    Title="{Binding [MatchTitle], Source={StaticResource Localization}}"
    Style="{StaticResource MatchWindowStyle}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewboxStyle}">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle
                            Width="24"
                            Height="42"
                            Margin="0,0,16,0"
                            Fill="{StaticResource MatchDominoBrush}"
                            Style="{StaticResource PixelArtStyle}" />
                        <TextBlock
                            Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                            Style="{StaticResource PixelTextStyle}"
                            FontSize="16"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCardStyle}" Margin="0,0,8,8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock
                                    Text="{Binding [MatchTitle], Source={StaticResource Localization}}"
                                    Style="{StaticResource MatchHeadingStyle}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Text="{Binding [MatchPlaceholderDescription],
                                        Source={StaticResource Localization}}"
                                    Style="{StaticResource MatchBodyStyle}"
                                    Margin="0,16,0,32"
                                    TextAlignment="Center" />
                                <Button
                                    Content="{Binding [ViewResultsButtonLabel], Source={StaticResource Localization}}"
                                    Style="{StaticResource MatchButtonStyle}"
                                    Command="{Binding ResultsCommand}"
                                    Background="{StaticResource Aqua}"
                                    HorizontalAlignment="Center"
                                    MinWidth="300" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

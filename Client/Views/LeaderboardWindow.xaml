<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    x:Class="DominoTrainGame.Client.View.Views.LeaderboardWindow"
    Title="{Binding [LeaderboardTitle], Source={StaticResource Localization}}"
    Width="960"
    Height="700"
    MinWidth="740"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource AppWindowStyle}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Text="{Binding [LeaderboardTitle], Source={StaticResource Localization}}"
            Style="{StaticResource PixelTextStyle}"
            FontSize="22"
            Margin="0,0,0,16" />
        <TextBlock
            Grid.Row="1"
            Text="{Binding [LeaderboardExplanation], Source={StaticResource Localization}}"
            Foreground="{StaticResource Ink}"
            FontSize="14"
            TextWrapping="Wrap"
            Margin="0,0,0,16" />
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                Content="{Binding [LeaderboardFilterLabel], Source={StaticResource Localization}}"
                Target="{Binding ElementName=PlayerFilterTextBox}"
                VerticalAlignment="Center"
                Foreground="{StaticResource Ink}"
                Margin="0,0,12,0" />
            <TextBox
                x:Name="PlayerFilterTextBox"
                Grid.Column="1"
                MaxLength="45"
                Padding="8"
                VerticalContentAlignment="Center"
                FontSize="14"
                Text="{Binding PlayerFilter, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{Binding [LeaderboardFilterLabel], Source={StaticResource Localization}}" />
            <Button
                Grid.Column="2"
                Content="{Binding [RefreshButtonLabel], Source={StaticResource Localization}}"
                Style="{StaticResource PixelButtonStyle}"
                Margin="16,0,0,0"
                IsEnabled="{Binding CanRefresh}"
                Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>
        <DataGrid
            Grid.Row="3"
            ItemsSource="{Binding Entries}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserSortColumns="True"
            CanUserReorderColumns="False"
            HeadersVisibility="Column"
            RowHeaderWidth="0"
            Background="{StaticResource Glacier}"
            Foreground="{StaticResource Ink}"
            BorderBrush="{StaticResource Ink}"
            BorderThickness="2"
            RowBackground="White"
            AlternatingRowBackground="{StaticResource Mist}"
            GridLinesVisibility="Horizontal"
            HorizontalGridLinesBrush="{StaticResource Mint}"
            FontSize="14"
            RowHeight="42"
            ColumnHeaderHeight="48"
            AutomationProperties.Name="{Binding [LeaderboardTitle], Source={StaticResource Localization}}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Glacier}" />
                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Rank}"
                    SortMemberPath="Rank"
                    Width="100"
                    Header="{Binding [RankLabel], Source={StaticResource Localization}}" />
                <DataGridTextColumn
                    Binding="{Binding Username}"
                    SortMemberPath="Username"
                    Width="*"
                    MinWidth="170"
                    Header="{Binding [PlayerLabel], Source={StaticResource Localization}}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Username}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Binding="{Binding Wins}"
                    SortMemberPath="Wins"
                    Width="110"
                    Header="{Binding [WinsLabel], Source={StaticResource Localization}}" />
                <DataGridTextColumn
                    Binding="{Binding GamesPlayed}"
                    SortMemberPath="GamesPlayed"
                    Width="170"
                    Header="{Binding [GamesPlayedLabel], Source={StaticResource Localization}}" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock
            Grid.Row="4"
            Text="{Binding StatusMessage}"
            Foreground="{StaticResource Ink}"
            FontSize="14"
            TextWrapping="Wrap"
            Margin="0,12,0,0"
            AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>

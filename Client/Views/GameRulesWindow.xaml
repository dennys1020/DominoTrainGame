<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    xmlns:controls="clr-namespace:DominoTrainGame.Client.View.Views.Controls"
    x:Class="DominoTrainGame.Client.View.Views.GameRulesWindow"
    Title="{Binding [GameRulesTitle], Source={StaticResource Localization}}"
    Style="{StaticResource MatchWindowStyle}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewboxStyle}">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle
                                Width="24"
                                Height="42"
                                Margin="0,0,16,0"
                                Fill="{StaticResource MatchDominoBrush}"
                                Style="{StaticResource PixelArtStyle}" />
                            <TextBlock
                                Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:SettingsButton HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCardStyle}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding [GameRulesTitle], Source={StaticResource Localization}}"
                                        Style="{StaticResource MatchHeadingStyle}" />
                                </StackPanel>
                                <ScrollViewer
                                    Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    PanningMode="VerticalOnly"
                                    Padding="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Grid.Row="0"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesObjectiveTitle],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchSectionStyle}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesObjectiveDescription],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchBodyStyle}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Grid.Row="0"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesPreparationTitle],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchSectionStyle}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesPreparationDescription],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchBodyStyle}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="0"
                                            Grid.Row="1"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesTurnTitle],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchSectionStyle}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesTurnDescription],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchBodyStyle}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Grid.Row="1"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesDrawTitle],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchSectionStyle}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesDrawDescription],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchBodyStyle}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="0"
                                            Grid.Row="2"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesDoublesTitle],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchSectionStyle}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesDoublesDescription],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchBodyStyle}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Grid.Row="2"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesScoringTitle],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchSectionStyle}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesScoringDescription],
                                                            Source={StaticResource Localization}}"
                                                        Style="{StaticResource MatchBodyStyle}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,8,4">
                        <Button
                            Content="{Binding [BackButtonLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource MatchButtonStyle}"
                            Command="{Binding DataContext.CloseCommand,
                                RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Left"
                            MinWidth="170" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    x:Class="DominoTrainGame.Client.View.Views.ProfileWindow"
    Title="{Binding [ProfileLabel], Source={StaticResource Localization}}"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="ProfileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="ProfileTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource Frost}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Mint}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FrameBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FrameBorder" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{StaticResource Mist}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileBiographyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ProfileTextBoxStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FrameBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FrameBorder" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfileButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Frost}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
                            <Border x:Name="ShadowBorder" Background="{StaticResource Ink}" Margin="4,4,0,0" />
                            <Border
                                x:Name="FaceBorder"
                                Margin="0,0,4,4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="3">
                                <TextBlock
                                    Text="{TemplateBinding Content}"
                                    FontFamily="{StaticResource PixelFont}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    TextOptions.TextFormattingMode="Display"
                                    TextOptions.TextRenderingMode="Aliased"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="GlowBorder"
                                Margin="0,0,4,4"
                                Background="White"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FaceBorder" Property="BorderThickness" Value="4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FaceBorder" Property="Margin" Value="4,4,0,0" />
                                <Setter TargetName="GlowBorder" Property="Margin" Value="4,4,0,0" />
                                <Setter TargetName="ShadowBorder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProfilePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ProfileButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="Foreground" Value="{StaticResource Glacier}" />
        </Style>
        <Style x:Key="ProfileIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
                            <Border x:Name="ShadowBorder" Background="{StaticResource Ink}" Margin="3,3,0,0" />
                            <Border
                                x:Name="FaceBorder"
                                Margin="0,0,3,3"
                                Background="{StaticResource Frost}"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="GlowBorder"
                                Margin="0,0,3,3"
                                Background="White"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FaceBorder" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FaceBorder" Property="Margin" Value="3,3,0,0" />
                                <Setter TargetName="GlowBorder" Property="Margin" Value="3,3,0,0" />
                                <Setter TargetName="ShadowBorder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AvatarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,20,16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="FrameBorder"
                            Background="{StaticResource Frost}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="FrameBorder"
                                    Property="Background"
                                    Value="{StaticResource Seafoam}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FrameBorder" Property="Background" Value="{StaticResource Aqua}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AvatarListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AvatarListBoxItemStyle}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource Mist}">
        <Rectangle Fill="{StaticResource ProfileGrid}" Opacity="0.6" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewboxStyle}">
            <Grid Width="1200" Height="820" Margin="0" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Top" Margin="0,6,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource Frost}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Canvas>
                                        <Rectangle
                                            Fill="{StaticResource DominoLogoBrush}"
                                            Style="{StaticResource PixelArtStyle}"
                                            Width="30"
                                            Height="31" />
                                    </Canvas>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelTextStyle}"
                                    FontSize="16" />
                            </StackPanel>
                        </StackPanel>
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{StaticResource Frost}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Padding="12,9">
                            <TextBlock
                                Text="{Binding [ProfileLabel], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="9" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="252" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="268" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Background="{StaticResource Aqua}"
                                        BorderBrush="{StaticResource Ink}"
                                        BorderThickness="0,0,4,0">
                                        <Grid Width="170" Height="170">
                                            <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                                            <Border
                                                Background="{StaticResource Frost}"
                                                BorderBrush="{StaticResource Ink}"
                                                BorderThickness="3"
                                                Margin="0,0,4,4">
                                                <Rectangle
                                                    Width="160"
                                                    Height="160"
                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                    Fill="{StaticResource DefaultAvatarBrush}"
                                                    Style="{StaticResource PixelArtStyle}" />
                                            </Border>
                                            <Button
                                                Style="{StaticResource ProfileIconButtonStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,-14,-12"
                                                Command="{Binding DataContext.EditCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Rectangle
                                                    Width="20"
                                                    Height="20"
                                                    Fill="{StaticResource EditBrush}"
                                                    Style="{StaticResource PixelArtStyle}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="1" Margin="28,20,28,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Width="360"
                                                Style="{StaticResource ProfileTextBoxStyle}"
                                                IsReadOnly="True" />
                                            <Button
                                                Grid.Column="1"
                                                Margin="14,0,0,0"
                                                Style="{StaticResource ProfileIconButtonStyle}"
                                                Command="{Binding DataContext.EditCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Rectangle
                                                    Width="20"
                                                    Height="20"
                                                    Fill="{StaticResource EditBrush}"
                                                    Style="{StaticResource PixelArtStyle}" />
                                            </Button>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="28,0,0,0">
                                                <Button
                                                    Style="{StaticResource ProfileIconButtonStyle}"
                                                    Margin="0,0,14,0"
                                                    Command="{Binding DataContext.InstagramCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Rectangle
                                                        Width="22"
                                                        Height="22"
                                                        Fill="{StaticResource CameraBrush}"
                                                        Style="{StaticResource PixelArtStyle}" />
                                                </Button>
                                                <Button
                                                    Style="{StaticResource ProfileIconButtonStyle}"
                                                    Margin="0,0,14,0"
                                                    Command="{Binding DataContext.EditCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Rectangle
                                                        Width="20"
                                                        Height="20"
                                                        Fill="{StaticResource CancelBrush}"
                                                        Style="{StaticResource PixelArtStyle}" />
                                                </Button>
                                                <Button
                                                    Style="{StaticResource ProfileIconButtonStyle}"
                                                    Command="{Binding DataContext.FacebookCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Rectangle
                                                        Width="22"
                                                        Height="22"
                                                        Fill="{StaticResource SocialBrush}"
                                                        Style="{StaticResource PixelArtStyle}" />
                                                </Button>
                                            </StackPanel>
                                            <Button
                                                Grid.Column="4"
                                                Style="{StaticResource ProfileIconButtonStyle}"
                                                Command="{Binding DataContext.CloseCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Rectangle
                                                    Width="16"
                                                    Height="16"
                                                    Fill="{StaticResource CloseBrush}"
                                                    Style="{StaticResource PixelArtStyle}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding [BiographyLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource ProfileLabelStyle}"
                                            FontSize="9"
                                            Margin="0,14,0,6" />
                                        <TextBox
                                            Grid.Row="2"
                                            Style="{StaticResource ProfileBiographyTextBoxStyle}"
                                            IsReadOnly="True" />
                                    </Grid>
                                </Grid>
                                <Rectangle Grid.Row="1" Fill="{StaticResource Ink}" />
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="28,20,28,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel>
                                            <TextBlock
                                                Text="{Binding [AvatarSectionLabel],
                                                    Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelTextStyle}"
                                                FontSize="10"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                Margin="0,0,18,0" />
                                            <Border
                                                Background="{StaticResource Ink}"
                                                Height="2"
                                                VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ListBox
                                            Grid.Row="1"
                                            Style="{StaticResource AvatarListBoxStyle}"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            ItemTemplate="{StaticResource AvatarPreviewTemplate}" />
                                    </Grid>
                                    <Rectangle Grid.Column="1" Fill="{StaticResource Ink}" />
                                    <Border Grid.Column="2" Background="{StaticResource Aqua}">
                                        <Grid Margin="24,20,24,24">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel>
                                                <TextBlock
                                                    Text="{Binding [StatisticsLabel],
                                                        Source={StaticResource Localization}}"
                                                    Style="{StaticResource PixelTextStyle}"
                                                    FontSize="10"
                                                    VerticalAlignment="Center"
                                                    DockPanel.Dock="Left"
                                                    Margin="0,0,14,0" />
                                                <Border
                                                    Background="{StaticResource Ink}"
                                                    Height="2"
                                                    VerticalAlignment="Center" />
                                            </DockPanel>
                                            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                <TextBlock
                                                    Text="{Binding [GamesPlayedLabel],
                                                        Source={StaticResource Localization}}"
                                                    Style="{StaticResource ProfileLabelStyle}"
                                                    FontSize="9" />
                                                <TextBlock
                                                    Style="{StaticResource PixelTextStyle}"
                                                    FontSize="18"
                                                    Margin="0,8,0,20" />
                                                <TextBlock
                                                    Text="{Binding [WinsLabel], Source={StaticResource Localization}}"
                                                    Style="{StaticResource ProfileLabelStyle}"
                                                    FontSize="9" />
                                                <TextBlock
                                                    Style="{StaticResource PixelTextStyle}"
                                                    FontSize="18"
                                                    Margin="0,8,0,20" />
                                                <TextBlock
                                                    Text="{Binding [MemberSinceLabel],
                                                        Source={StaticResource Localization}}"
                                                    Style="{StaticResource ProfileLabelStyle}"
                                                    FontSize="9" />
                                                <TextBlock
                                                    Style="{StaticResource PixelTextStyle}"
                                                    FontSize="18"
                                                    Margin="0,8,0,0" />
                                            </StackPanel>
                                            <Grid Grid.Row="2" Height="52">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.ColumnSpan="3"
                                                    Content="{Binding [EditButtonLabel],
                                                        Source={StaticResource Localization}}"
                                                    Style="{StaticResource ProfilePrimaryButtonStyle}"
                                                    Command="{Binding DataContext.EditCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button
                                                    Content="{Binding [CancelButtonLabel],
                                                        Source={StaticResource Localization}}"
                                                    Style="{StaticResource ProfileButtonStyle}"
                                                    Visibility="Collapsed"
                                                    Command="{Binding DataContext.CancelEditingCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Content="{Binding [SaveButtonLabel],
                                                        Source={StaticResource Localization}}"
                                                    Style="{StaticResource ProfilePrimaryButtonStyle}"
                                                    Visibility="Collapsed"
                                                    Command="{Binding DataContext.SaveCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

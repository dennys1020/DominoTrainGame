<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DominoTrainGame.Client.View.Behaviors"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    xmlns:controls="clr-namespace:DominoTrainGame.Client.View.Views.Controls"
    x:Class="DominoTrainGame.Client.View.Views.SignUpWindow"
    Title="{Binding [RegistrationTitle], Source={StaticResource Localization}}"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Style x:Key="NightLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextLightStyle}">
            <Setter Property="Foreground" Value="{StaticResource NightMuted}" />
        </Style>
        <Style x:Key="NightTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource NightText}" />
            <Setter Property="CaretBrush" Value="{StaticResource NightAccent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource NightBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FrameBorder"
                            Background="{StaticResource NightInput}"
                            BorderBrush="{StaticResource NightBorder}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="FrameBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource NightAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NightPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource NightText}" />
            <Setter Property="CaretBrush" Value="{StaticResource NightAccent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource NightBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="FrameBorder"
                            Background="{StaticResource NightInput}"
                            BorderBrush="{StaticResource NightBorder}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="FrameBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource NightAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NightButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
            <Setter Property="Background" Value="{StaticResource NightInput}" />
            <Setter Property="Foreground" Value="{StaticResource NightAccent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ShadowBorder" Background="{StaticResource NightBorder}" Margin="4,4,0,0" />
                            <Border
                                x:Name="FaceBorder"
                                Margin="0,0,4,4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource NightAccent}"
                                BorderThickness="3"
                                Padding="{TemplateBinding Padding}">
                                <TextBlock
                                    Text="{TemplateBinding Content}"
                                    Style="{StaticResource PixelTextStyle}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border
                                x:Name="GlowBorder"
                                Margin="0,0,4,4"
                                Background="White"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlowBorder" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FaceBorder" Property="BorderThickness" Value="4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FaceBorder" Property="Margin" Value="4,4,0,0" />
                                <Setter TargetName="GlowBorder" Property="Margin" Value="4,4,0,0" />
                                <Setter TargetName="ShadowBorder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NightPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NightButtonStyle}">
            <Setter Property="Background" Value="{StaticResource NightAccent}" />
            <Setter Property="Foreground" Value="{StaticResource NightOnAccent}" />
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource NightBackground}">
        <Rectangle Fill="{StaticResource NightGrid}" Opacity="0.6" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewboxStyle}">
            <Grid Width="1200" Height="820" Margin="0" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Top" Margin="0,6,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource NightBorder}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource NightInput}"
                                    BorderBrush="{StaticResource NightAccent}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Canvas>
                                        <Rectangle
                                            Fill="{StaticResource DominoLogoNightAccentBrush}"
                                            Style="{StaticResource PixelArtStyle}"
                                            Width="30"
                                            Height="31" />
                                    </Canvas>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelTextLightStyle}"
                                    FontSize="16" />
                            </StackPanel>
                            <controls:SettingsButton Margin="24,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border
                                Background="{StaticResource NightInput}"
                                BorderBrush="{StaticResource NightAccent}"
                                BorderThickness="2"
                                Padding="12,9">
                                <TextBlock
                                    Text="{Binding [RegistrationTitle], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelTextDarkStyle}"
                                    FontSize="9" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource NightShadow}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource NightCard}"
                            BorderBrush="{StaticResource NightBorder}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource NightSidebar}"
                                    BorderBrush="{StaticResource NightBorder}"
                                    BorderThickness="0,0,4,0">
                                    <Grid ClipToBounds="True">
                                        <Rectangle
                                            Fill="{StaticResource NightTrainSceneBrush}"
                                            Style="{StaticResource PixelArtStyle}"
                                            Width="264"
                                            Height="256"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,92"
                                            IsHitTestVisible="False"
                                            RenderOptions.EdgeMode="Aliased" />
                                        <StackPanel VerticalAlignment="Top" Margin="24,28,24,0">
                                            <TextBlock
                                                Text="{Binding [NewPassengerSubtitle],
                                                    Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelTextDarkStyle}"
                                                FontSize="9" />
                                            <TextBlock
                                                Text="{Binding [JoinTableTitle], Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelTextLightStyle}"
                                                TextWrapping="Wrap"
                                                FontSize="16"
                                                LineHeight="28"
                                                Margin="0,16,0,0" />
                                            <TextBlock
                                                Text="{Binding [RegisterDescription],
                                                    Source={StaticResource Localization}}"
                                                Foreground="{StaticResource NightMuted}"
                                                TextWrapping="Wrap"
                                                FontSize="13"
                                                Margin="0,14,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1" Margin="36,28,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="74" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [RegistrationTitle], Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelTextLightStyle}"
                                            FontSize="24"
                                            Margin="0,2,0,0" />
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock
                                            Text="{Binding [CredentialSectionLabel],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelTextDarkStyle}"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,18,0" />
                                        <Border
                                            Background="{StaticResource NightBorder}"
                                            Height="2"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="2" Width="560" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock
                                            Text="{Binding [EmailAddressLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource NightLabelStyle}"
                                            FontSize="10"
                                            Margin="0,0,0,8" />
                                        <TextBox
                                            Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource NightTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Width="560" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock
                                            Text="{Binding [UsernameLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource NightLabelStyle}"
                                            FontSize="10"
                                            Margin="0,0,0,8" />
                                        <TextBox
                                            Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource NightTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Width="560" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock
                                            Text="{Binding [PasswordLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource NightLabelStyle}"
                                            FontSize="10"
                                            Margin="0,0,0,8" />
                                        <PasswordBox
                                            behaviors:PasswordBoxBinding.BoundPassword="{Binding Password,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource NightPasswordBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="5" Margin="0,26,0,0" VerticalAlignment="Bottom">
                                        <Grid>
                                            <Button
                                                Content="{Binding [SignUpButtonLabel],
                                                    Source={StaticResource Localization}}"
                                                Style="{StaticResource NightPrimaryButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Width="188"
                                                Height="50"
                                                IsDefault="True"
                                                Command="{Binding DataContext.SignUpCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,24,0,0">
                                            <TextBlock
                                                Text="{Binding [AlreadyHaveAccountLabel],
                                                    Source={StaticResource Localization},
                                                    Mode=OneWay}"
                                                Style="{StaticResource NightLabelStyle}"
                                                FontSize="13"
                                                Margin="0,0,13,0" />
                                            <TextBlock
                                                Style="{StaticResource NightLabelStyle}"
                                                FontSize="13">
                                                <Hyperlink
                                                    Command="{Binding DataContext.LogInCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Foreground="{StaticResource NightAccent}"
                                                    TextDecorations="None">
                                                    <Run
                                                        Text="{Binding [LoginLabel],
                                                            Source={StaticResource Localization},
                                                            Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

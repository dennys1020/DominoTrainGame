<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Client.Models.Resources.Localization;assembly=Models"
    x:Class="DominoTrainGame.Client.View.Views.FriendsListWindow"
    Title="{Binding [FriendsLabel], Source={StaticResource Localization}}"
    Width="1200"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="TabVisibility" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton
                Grid.Column="0"
                GroupName="Tabs"
                Content="{Binding [FriendsLabel], Source={StaticResource Localization}}"
                Style="{StaticResource TabButtonStyle}"
                IsChecked="{Binding IsFriendsSelected, Mode=TwoWay}" />
            <RadioButton
                Grid.Column="1"
                GroupName="Tabs"
                Content="{Binding [RequestsLabel], Source={StaticResource Localization}}"
                Style="{StaticResource TabButtonStyle}"
                IsChecked="{Binding IsRequestsSelected, Mode=TwoWay}" />
        </Grid>
        <StackPanel
            Visibility="{Binding IsFriendsSelected, Converter={StaticResource TabVisibility}}"
            Grid.Row="1"
            Margin="0,20,0,0">
            <Border
                Background="{StaticResource Glacier}"
                BorderBrush="{StaticResource Ink}"
                BorderThickness="2"
                Padding="16"
                Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding Friends}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="White"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            Fill="{StaticResource PersonBrush}"
                                            Style="{StaticResource PixelArtStyle}" />
                                        <TextBlock
                                            Text="{Binding Username}"
                                            Style="{StaticResource PixelTextStyle}"
                                            VerticalAlignment="Center" />
                                        <Rectangle
                                            Width="10"
                                            Height="10"
                                            Margin="12,0,6,0"
                                            Fill="{StaticResource Mint}"
                                            Visibility="{Binding IsConnected,
                                                Converter={StaticResource TabVisibility}}" />
                                        <TextBlock
                                            Text="{Binding StatusLabel}"
                                            Style="{StaticResource PixelTextStyle}"
                                            FontSize="10"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource DangerPixelButtonStyle}"
                                        Command="{Binding RemoveCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                Fill="{StaticResource TrashBrush}"
                                                Style="{StaticResource PixelArtStyle}" />
                                            <TextBlock
                                                Text="{Binding [RemoveButtonLabel],
                                                    Source={StaticResource Localization}}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border
                Background="{StaticResource Aqua}"
                BorderBrush="{StaticResource Ink}"
                BorderThickness="2"
                Padding="16">
                <StackPanel>
                    <Grid>
                        <TextBox
                            Height="40"
                            FontFamily="Consolas"
                            FontSize="14"
                            Padding="34,8,8,8"
                            Text="{Binding FriendUsername, UpdateSourceTrigger=PropertyChanged}" />
                        <Rectangle
                            Width="18"
                            Height="18"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False"
                            Fill="{StaticResource SearchBrush}"
                            Style="{StaticResource PixelArtStyle}" />
                    </Grid>
                    <Border
                        Margin="0,8,0,0"
                        Background="{StaticResource Glacier}"
                        BorderBrush="{StaticResource Ink}"
                        BorderThickness="2"
                        Padding="8"
                        Visibility="{Binding HasSearchResults, Converter={StaticResource TabVisibility}}">
                        <ListBox
                            MaxHeight="240"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding SearchResults}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="20"
                                            BorderBrush="{StaticResource Ink}"
                                            BorderThickness="2"
                                            Margin="0,0,10,0"
                                            Background="{StaticResource DefaultAvatarBrush}" />
                                        <Border
                                            Grid.Column="1"
                                            Background="Gold"
                                            BorderBrush="{StaticResource Ink}"
                                            BorderThickness="1"
                                            Padding="10,6"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Username}"
                                                Style="{StaticResource PixelTextStyle}" />
                                        </Border>
                                        <Button
                                            Grid.Column="2"
                                            Content="{Binding [AddButtonLabel],
                                                Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelButtonStyle}"
                                            Command="{Binding SendRequestCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button
                            Content="{Binding [AddButtonLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource PixelButtonStyle}"
                            Command="{Binding AddFriendCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Margin="0,20,0,0"
            Visibility="{Binding IsRequestsSelected, Converter={StaticResource TabVisibility}}">
            <Border
                Background="{StaticResource Glacier}"
                BorderBrush="{StaticResource Ink}"
                BorderThickness="2"
                Padding="16">
                <ItemsControl ItemsSource="{Binding PendingRequests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="White"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="1"
                                Padding="10"
                                Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle
                                            Width="24"
                                            Height="24"
                                            Margin="0,0,10,0"
                                            Fill="{StaticResource PersonBrush}"
                                            Style="{StaticResource PixelArtStyle}" />
                                        <TextBlock
                                            Text="{Binding Username}"
                                            Style="{StaticResource PixelTextStyle}"
                                            VerticalAlignment="Center"
                                            FontSize="16" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource PixelIconButtonStyle}"
                                        Background="#32CD32"
                                        Width="40"
                                        Height="40"
                                        Margin="0,0,10,0"
                                        Command="{Binding AcceptCommand}">
                                        <Rectangle
                                            Width="24"
                                            Height="24"
                                            Fill="{StaticResource CheckBrush}"
                                            Style="{StaticResource PixelArtStyle}" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource DangerPixelButtonStyle}"
                                        Width="40"
                                        Height="40"
                                        Command="{Binding RejectCommand}">
                                        <Rectangle
                                            Width="20"
                                            Height="20"
                                            Fill="{StaticResource CancelBrush}"
                                            Style="{StaticResource PixelArtStyle}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Grid>
</Window>

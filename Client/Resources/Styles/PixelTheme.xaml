<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="PixelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
    </Style>
    <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="8" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PixelSliderStyle" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="5" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="TickFrequency" Value="5" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid SnapsToDevicePixels="True">
                        <Border
                            x:Name="VolumeRailBorder"
                            Height="20"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Background="{StaticResource Mint}" />
                        <Border Height="8" Margin="8,0" Background="{StaticResource Mist}" />
                        <Track
                            x:Name="PART_Track"
                            Margin="6,0"
                            Minimum="{TemplateBinding Minimum}"
                            Maximum="{TemplateBinding Maximum}"
                            Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Style="{StaticResource TrackButtonStyle}"
                                    Background="{StaticResource VolumeSegments}"
                                    Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="26" Height="34">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border Margin="3,3,0,0" Background="{StaticResource Ink}" />
                                                <Border
                                                    x:Name="SliderHandleBorder"
                                                    Margin="0,0,3,3"
                                                    Background="{StaticResource Glacier}"
                                                    BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="3">
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <Rectangle
                                                            Width="2"
                                                            Height="11"
                                                            Fill="{StaticResource Ink}"
                                                            Margin="0,0,3,0" />
                                                        <Rectangle Width="2" Height="11" Fill="{StaticResource Ink}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter
                                                        TargetName="SliderHandleBorder"
                                                        Property="Background"
                                                        Value="{StaticResource Frost}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Style="{StaticResource TrackButtonStyle}"
                                    Background="Transparent"
                                    Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="VolumeRailBorder" Property="BorderThickness" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PixelButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Mist}" />
        <Setter Property="Padding" Value="22,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                        <Border
                            x:Name="ButtonSurfaceBorder"
                            Margin="0,0,4,4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <TextBlock
                                Text="{TemplateBinding Content}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="ButtonSurfaceBorder"
                                Property="Background"
                                Value="{StaticResource Frost}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonSurfaceBorder" Property="BorderThickness" Value="4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurfaceBorder" Property="Margin" Value="3,3,1,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PixelIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="4,4,0,0" Background="{StaticResource Ink}" />
                        <Border
                            x:Name="ButtonSurfaceBorder"
                            Margin="0,0,4,4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="ButtonSurfaceBorder"
                                Property="Background"
                                Value="{StaticResource Frost}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonSurfaceBorder" Property="BorderThickness" Value="4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonSurfaceBorder" Property="Margin" Value="3,3,1,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LanguageOptionStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="LanguageCardBorder"
                        BorderBrush="{StaticResource Ink}"
                        BorderThickness="2"
                        Background="{StaticResource Mist}"
                        Padding="16,14"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Border
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="2"
                                Background="{StaticResource Glacier}">
                                <Rectangle
                                    x:Name="SelectionMarkRectangle"
                                    Visibility="Collapsed"
                                    Fill="{StaticResource CheckBrush}"
                                    Margin="2"
                                    RenderOptions.EdgeMode="Aliased" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="LanguageCardBorder"
                                Property="Background"
                                Value="{StaticResource Frost}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter
                                TargetName="LanguageCardBorder"
                                Property="Background"
                                Value="{StaticResource Aqua}" />
                            <Setter TargetName="SelectionMarkRectangle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="LanguageCardBorder" Property="BorderThickness" Value="3" />
                            <Setter TargetName="LanguageCardBorder" Property="Padding" Value="15,13" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PixelTextDarkStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Foreground" Value="{StaticResource NightAccent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
    </Style>
    <Style x:Key="PixelTextLightStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Foreground" Value="{StaticResource NightText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
    </Style>
    <Style x:Key="NightLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextLightStyle}">
        <Setter Property="Foreground" Value="{StaticResource NightMuted}" />
    </Style>
    <Style x:Key="NightTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="44" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource NightText}" />
        <Setter Property="CaretBrush" Value="{StaticResource NightAccent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource NightBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="FrameBorder"
                        Background="{StaticResource NightInput}"
                        BorderBrush="{StaticResource NightBorder}"
                        BorderThickness="2"
                        Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter
                                TargetName="FrameBorder"
                                Property="BorderBrush"
                                Value="{StaticResource NightAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NightLinkButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="Foreground" Value="{StaticResource NightAccent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock
                        x:Name="LinkTextBlock"
                        Text="{TemplateBinding Content}"
                        Foreground="{TemplateBinding Foreground}"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LinkTextBlock" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="LinkTextBlock" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NightButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
        <Setter Property="Background" Value="{StaticResource NightInput}" />
        <Setter Property="Foreground" Value="{StaticResource NightAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="ShadowBorder" Background="{StaticResource NightBorder}" Margin="4,4,0,0" />
                        <Border
                            x:Name="FaceBorder"
                            Margin="0,0,4,4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource NightAccent}"
                            BorderThickness="3"
                            Padding="{TemplateBinding Padding}">
                            <TextBlock
                                Text="{TemplateBinding Content}"
                                Style="{StaticResource PixelTextStyle}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <Border
                            x:Name="GlowBorder"
                            Margin="0,0,4,4"
                            Background="White"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlowBorder" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FaceBorder" Property="BorderThickness" Value="4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="FaceBorder" Property="Margin" Value="4,4,0,0" />
                            <Setter TargetName="GlowBorder" Property="Margin" Value="4,4,0,0" />
                            <Setter TargetName="ShadowBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NightPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NightButtonStyle}">
        <Setter Property="Background" Value="{StaticResource NightAccent}" />
        <Setter Property="Foreground" Value="{StaticResource NightOnAccent}" />
    </Style>
    <Style x:Key="NightPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Height" Value="44" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource NightText}" />
        <Setter Property="CaretBrush" Value="{StaticResource NightAccent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource NightBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border
                        x:Name="FrameBorder"
                        Background="{StaticResource NightInput}"
                        BorderBrush="{StaticResource NightBorder}"
                        BorderThickness="2"
                        Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter
                                TargetName="FrameBorder"
                                Property="BorderBrush"
                                Value="{StaticResource NightAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DangerPixelButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#B33A3A" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="TabButtonStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="TabSurfaceBorder"
                        Background="{StaticResource Mint}"
                        BorderBrush="{StaticResource Ink}"
                        BorderThickness="0,0,2,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabSurfaceBorder" Property="Background" Value="{StaticResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MenuIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{StaticResource Glacier}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="4,4,0,0" Background="{StaticResource Ink}" />
                        <Border
                            x:Name="FaceBorder"
                            Margin="0,0,4,4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FaceBorder" Property="Background" Value="{StaticResource Frost}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FaceBorder" Property="Background" Value="{StaticResource Frost}" />
                            <Setter TargetName="FaceBorder" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="FaceBorder" Property="Margin" Value="3,3,1,1" />
                            <Setter TargetName="FaceBorder" Property="Background" Value="{StaticResource Seafoam}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

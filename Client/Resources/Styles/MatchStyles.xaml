<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DominoTrainGame.Client.View.Behaviors">
    <Style x:Key="MatchWindowStyle" TargetType="Window" BasedOn="{StaticResource AppWindowStyle}">
        <Setter Property="Height" Value="860" />
        <Setter Property="Background" Value="{StaticResource Glacier}" />
    </Style>
    <Style x:Key="MatchCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Glacier}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="30" />
    </Style>
    <Style x:Key="MatchHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextStyle}">
        <Setter Property="FontSize" Value="23" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="34" />
    </Style>
    <Style x:Key="MatchBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="26" />
    </Style>
    <Style x:Key="MatchSectionStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="MatchButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style x:Key="MatchDoubleOptionStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="OptionSurfaceBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{StaticResource Glacier}"
                        BorderBrush="{StaticResource Ink}"
                        BorderThickness="2">
                        <TextBlock
                            Text="{TemplateBinding Content}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter
                                TargetName="OptionSurfaceBorder"
                                Property="Background"
                                Value="{StaticResource Frost}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter
                                TargetName="OptionSurfaceBorder"
                                Property="Background"
                                Value="{StaticResource Aqua}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter
                                TargetName="OptionSurfaceBorder"
                                Property="BorderBrush"
                                Value="{StaticResource Aqua}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MatchInputStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Mist}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Frost}" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="InputSurfaceBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter
                                TargetName="InputSurfaceBorder"
                                Property="Background"
                                Value="{StaticResource Frost}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MatchTableCellStyle" TargetType="TextBlock" BasedOn="{StaticResource MatchBodyStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="MatchSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="MatchHeaderStatStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="MatchStatTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MatchBodyStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="DominoTileBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Mist}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style x:Key="TrainTileBorderStyle" TargetType="Border" BasedOn="{StaticResource DominoTileBorderStyle}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style x:Key="HandTileBorderStyle" TargetType="Border" BasedOn="{StaticResource DominoTileBorderStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="84" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="EngineTileBorderStyle" TargetType="Border" BasedOn="{StaticResource DominoTileBorderStyle}">
        <Setter Property="Width" Value="84" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Background" Value="{StaticResource Aqua}" />
    </Style>
    <Style x:Key="DominoPipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TrainLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PixelTextStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TrainBadgeStyle" TargetType="TextBlock" BasedOn="{StaticResource MatchBodyStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="TrainRowStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Glacier}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="MinHeight" Value="56" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter Property="Background" Value="{StaticResource Mint}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMexicanTrain}" Value="True">
                <Setter Property="Background" Value="{StaticResource Seafoam}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Aqua}" />
                <Setter Property="BorderThickness" Value="4" />
            </DataTrigger>
            <Trigger Property="behaviors:TileDragDropBehavior.IsDragOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Aqua}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MatchPlayerCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Mist}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasTurn}" Value="True">
                <Setter Property="Background" Value="{StaticResource Aqua}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TurnBannerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Frost}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="WaitingTurnPanelStyle" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMyTurn}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

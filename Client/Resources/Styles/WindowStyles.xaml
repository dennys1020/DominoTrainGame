<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="AppWindowStyle" TargetType="Window">
        <Setter Property="Width" Value="1220" />
        <Setter Property="Height" Value="880" />
        <Setter Property="MinWidth" Value="960" />
        <Setter Property="MinHeight" Value="700" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="SizeToContent" Value="Manual" />
        <Setter Property="Background" Value="{StaticResource Mist}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="ScreenViewboxStyle" TargetType="Viewbox">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StretchDirection" Value="Both" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="PixelArtStyle" TargetType="Rectangle">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
    </Style>
    <Style x:Key="DialogViewboxStyle" TargetType="Viewbox" BasedOn="{StaticResource ScreenViewboxStyle}">
        <Setter Property="StretchDirection" Value="DownOnly" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>

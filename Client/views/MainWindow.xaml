<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Resources.Localization;assembly=Models"
    xmlns:controls="clr-namespace:DominoTrainGame.Views.Controls"
    x:Class="DominoTrainGame.Views.MainWindow"
    Title="{Binding [GameTitle], Source={StaticResource Localization}}"
    Height="800"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource Glacier}"
    Style="{StaticResource AppWindow}">
    <Grid Background="{StaticResource Glacier}">
        <Rectangle
            IsHitTestVisible="False"
            Fill="{StaticResource MenuLandscapeBrush}"
            Style="{StaticResource PixelArt}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.06" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewbox}">
            <Grid Width="1200" Height="740" ClipToBounds="True">
                <Canvas IsHitTestVisible="False">
                    <Rectangle
                        Canvas.Left="140"
                        Canvas.Top="342"
                        Width="78"
                        Height="140"
                        RenderTransformOrigin="0.5,0.5"
                        Fill="{StaticResource MenuDominoBrush}"
                        Style="{StaticResource PixelArt}">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="-14" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle
                        Canvas.Left="990"
                        Canvas.Top="282"
                        Width="91"
                        Height="164"
                        RenderTransformOrigin="0.5,0.5"
                        Fill="{StaticResource MenuDominoBrush}"
                        Style="{StaticResource PixelArt}">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="14" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle
                        Canvas.Left="250"
                        Canvas.Top="298"
                        Fill="{StaticResource SparkleSeafoamBrush}"
                        Style="{StaticResource PixelArt}"
                        Width="20"
                        Height="20" />
                    <Rectangle
                        Canvas.Left="918"
                        Canvas.Top="222"
                        Fill="{StaticResource SparkleAquaBrush}"
                        Style="{StaticResource PixelArt}"
                        Width="20"
                        Height="20" />
                    <Rectangle Canvas.Left="1076" Canvas.Top="166" Width="8" Height="8" Fill="{StaticResource Mint}" />
                    <Rectangle Canvas.Left="216" Canvas.Top="256" Width="8" Height="8" Fill="{StaticResource Mint}" />
                </Canvas>
                <StackPanel Margin="32,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Button
                        Style="{StaticResource MenuIconButton}"
                        Margin="0,0,0,14"
                        Command="{Binding DataContext.ProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{Binding [ProfileLabel], Source={StaticResource Localization}}">
                        <Rectangle
                            Width="41"
                            Height="43"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            Fill="{StaticResource DefaultAvatarBrush}"
                            Style="{StaticResource PixelArt}" />
                    </Button>
                    <Button
                        Style="{StaticResource MenuIconButton}"
                        Margin="0,0,0,14"
                        Command="{Binding DataContext.FriendsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="{Binding [FriendsLabel], Source={StaticResource Localization}}">
                        <Rectangle
                            Width="36"
                            Height="36"
                            Fill="{StaticResource MenuFriendsBrush}"
                            Style="{StaticResource PixelArt}" />
                    </Button>
                    <controls:SettingsButton />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,32,0">
                    <Button
                        Content="{Binding [GameRulesTitle], Source={StaticResource Localization}}"
                        Command="{Binding DataContext.RulesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PixelButton}"
                        FontSize="9"
                        Width="222"
                        Height="50"
                        Margin="0,0,0,12" />
                    <Button
                        Content="{Binding [MatchResultsTitle], Source={StaticResource Localization}}"
                        Command="{Binding DataContext.ResultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PixelButton}"
                        FontSize="9"
                        Width="250"
                        Height="50" />
                    <Button
                        Content="{Binding [LeaderboardTitle], Source={StaticResource Localization}}"
                        Command="{Binding DataContext.LeaderboardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PixelButton}"
                        FontSize="9"
                        Width="222"
                        Height="50"
                        Margin="0,12,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,100,0,0">
                    <Grid Height="66">
                        <TextBlock
                            Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                            Margin="5,5,0,0"
                            Style="{StaticResource PixelText}"
                            FontSize="48"
                            Foreground="{StaticResource Mint}"
                            IsHitTestVisible="False" />
                        <TextBlock
                            Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                            Style="{StaticResource PixelText}"
                            FontSize="48" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,38">
                        <Rectangle Width="40" Height="6" Fill="{StaticResource Mint}" Margin="0,0,8,0" />
                        <Rectangle Width="40" Height="6" Fill="{StaticResource Seafoam}" Margin="0,0,8,0" />
                        <Rectangle Width="40" Height="6" Fill="{StaticResource Aqua}" />
                    </StackPanel>
                    <Button
                        Content="{Binding [PlayButtonLabel], Source={StaticResource Localization}}"
                        Command="{Binding DataContext.NewGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PixelButton}"
                        Background="{StaticResource Aqua}"
                        FontSize="18"
                        Width="380"
                        Height="76"
                        Margin="0,0,0,16" />
                    <Button
                        Content="{Binding [LogOutButtonLabel], Source={StaticResource Localization}}"
                        Style="{StaticResource PixelButton}"
                        Background="{StaticResource Mist}"
                        FontSize="13"
                        Width="380"
                        Height="58"
                        Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <Rectangle
                    Width="660"
                    Height="228.8"
                    Margin="0,404,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Fill="{StaticResource MenuTrainBrush}"
                    Style="{StaticResource PixelArt}" />
            </Grid>
        </Viewbox>
    </Grid>
</Window>

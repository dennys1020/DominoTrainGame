<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Resources.Localization;assembly=Models"
    xmlns:controls="clr-namespace:DominoTrainGame.Views.Controls"
    x:Class="DominoTrainGame.Views.NewGameWindow"
    Title="{Binding [NewGameTitle], Source={StaticResource Localization}}"
    Style="{StaticResource MatchWindow}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewbox}">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle
                                Width="24"
                                Height="42"
                                Margin="0,0,16,0"
                                Fill="{StaticResource MatchDominoBrush}"
                                Style="{StaticResource PixelArt}" />
                            <TextBlock
                                Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                Style="{StaticResource PixelText}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:SettingsButton HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCard}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding [NewGameTitle], Source={StaticResource Localization}}"
                                        Style="{StaticResource MatchHeading}" />
                                    <TextBlock
                                        Text="{Binding [NewGameDescription], Source={StaticResource Localization}}"
                                        Style="{StaticResource MatchBody}"
                                        Margin="0,12,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MatchCard}" Background="{StaticResource Mist}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100" />
                                                <RowDefinition Height="50" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="60" />
                                            </Grid.RowDefinitions>
                                            <Rectangle
                                                Width="44"
                                                Height="77"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Fill="{StaticResource MatchDominoBrush}"
                                                Style="{StaticResource PixelArt}" />
                                            <TextBlock
                                                Text="{Binding [CreateGameTitle], Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchHeading}"
                                                Grid.Row="1"
                                                FontSize="19" />
                                            <TextBlock
                                                Text="{Binding [NewGameDescription], Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchBody}"
                                                Grid.Row="2"
                                                Margin="0,8,0,20" />
                                            <Button
                                                Content="{Binding [CreateGameTitle], Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchButton}"
                                                Command="{Binding DataContext.RoomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Grid.Row="3"
                                                Background="{StaticResource Aqua}" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        Style="{StaticResource MatchCard}"
                                        Background="{StaticResource Mist}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100" />
                                                <RowDefinition Height="50" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="60" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <Rectangle
                                                    Width="44"
                                                    Height="77"
                                                    Fill="{StaticResource MatchDominoBrush}"
                                                    Style="{StaticResource PixelArt}" />
                                                <Rectangle
                                                    Width="44"
                                                    Height="77"
                                                    Margin="14,0,0,0"
                                                    Fill="{StaticResource MatchDominoBrush}"
                                                    Style="{StaticResource PixelArt}" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding [JoinGameTitle], Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchHeading}"
                                                Grid.Row="1"
                                                FontSize="19" />
                                            <TextBlock
                                                Text="{Binding [JoinGameDescription], Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchBody}"
                                                Grid.Row="2"
                                                Margin="0,8,0,20" />
                                            <Button
                                                Content="{Binding [JoinGameTitle], Source={StaticResource Localization}}"
                                                Style="{StaticResource MatchButton}"
                                                Command="{Binding DataContext.JoinGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Grid.Row="3"
                                                Background="{StaticResource Frost}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,8,4">
                        <Button
                            Content="{Binding [BackButtonLabel], Source={StaticResource Localization}}"
                            Style="{StaticResource MatchButton}"
                            Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Left"
                            MinWidth="170" />
                        <Button
                            Content="{Binding [GameRulesTitle], Source={StaticResource Localization}}"
                            Style="{StaticResource MatchButton}"
                            Command="{Binding DataContext.RulesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            HorizontalAlignment="Right"
                            MinWidth="210" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

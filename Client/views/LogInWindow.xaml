<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DominoTrainGame.Behaviors"
    xmlns:strings="clr-namespace:DominoTrainGame.Resources.Localization;assembly=Models"
    xmlns:controls="clr-namespace:DominoTrainGame.Views.Controls"
    x:Class="DominoTrainGame.Views.LogInWindow"
    Title="{Binding [LoginLabel], Source={StaticResource Localization}}"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    <Window.Style>
        <Style TargetType="Window" BasedOn="{StaticResource AppWindow}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoggingIn}" Value="True">
                    <Setter Property="Cursor" Value="Wait" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Grid x:Name="loginContent" IsEnabled="{Binding IsContentEnabled}" Background="{StaticResource NightBackground}">
        <Rectangle Fill="{StaticResource NightGrid}" Opacity="0.6" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewbox}">
            <Grid Width="1200" Height="820" Margin="0" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Top" Margin="0,6,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource NightBorder}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource NightInput}"
                                    BorderBrush="{StaticResource NightAccent}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Canvas>
                                        <Rectangle
                                            Fill="{StaticResource DominoLogoNightAccentBrush}"
                                            Style="{StaticResource PixelArt}"
                                            Width="30"
                                            Height="31" />
                                    </Canvas>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelTextLight}"
                                    FontSize="16" />
                            </StackPanel>
                            <controls:SettingsButton Margin="24,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border
                                Background="{StaticResource NightInput}"
                                BorderBrush="{StaticResource NightAccent}"
                                BorderThickness="2"
                                Padding="12,9">
                                <TextBlock
                                    Text="{Binding [LoginLabel], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelTextDark}"
                                    FontSize="9" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource NightShadow}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource NightCard}"
                            BorderBrush="{StaticResource NightBorder}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource NightSidebar}"
                                    BorderBrush="{StaticResource NightBorder}"
                                    BorderThickness="0,0,4,0">
                                    <Grid ClipToBounds="True">
                                        <Rectangle
                                            Fill="{StaticResource NightTrainSceneBrush}"
                                            Style="{StaticResource PixelArt}"
                                            Width="264"
                                            Height="256"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,92"
                                            IsHitTestVisible="False"
                                            RenderOptions.EdgeMode="Aliased" />
                                        <StackPanel VerticalAlignment="Top" Margin="24,28,24,0">
                                            <TextBlock
                                                Text="{Binding [LoginLabel], Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelTextDark}"
                                                FontSize="9" />
                                            <TextBlock
                                                Text="{Binding [WelcomeBackTitle], Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelTextLight}"
                                                TextWrapping="Wrap"
                                                FontSize="16"
                                                LineHeight="28"
                                                Margin="0,16,0,0" />
                                            <TextBlock
                                                Text="{Binding [LoginSidebarDescription], Source={StaticResource Localization}}"
                                                Foreground="{StaticResource NightMuted}"
                                                TextWrapping="Wrap"
                                                FontSize="13"
                                                Margin="0,14,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1" Margin="36,28,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="74" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="100" />
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock
                                            Text="{Binding [LoginLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelTextLight}"
                                            FontSize="24"
                                            HorizontalAlignment="Left"
                                            Margin="0,2,0,0" />
                                        <Button
                                            Content="{Binding [GuestButtonLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelButton}"
                                            FontSize="9"
                                            Height="36"
                                            Padding="14,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top" />
                                    </Grid>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock
                                            Text="{Binding [CredentialSectionLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelTextDark}"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,18,0" />
                                        <Border
                                            Background="{StaticResource NightBorder}"
                                            Height="2"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <StackPanel Grid.Row="2" Width="560" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock
                                            Text="{Binding [EmailOrUsernameLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource NightLabel}"
                                            FontSize="10"
                                            Margin="0,0,0,8" />
                                        <TextBox
                                            x:Name="textBoxEmailUserName"
                                            Text="{Binding UsernameOrEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource NightTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Width="560" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock
                                            Text="{Binding [PasswordLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource NightLabel}"
                                            FontSize="10"
                                            Margin="0,0,0,8" />
                                        <PasswordBox
                                            x:Name="passwordBoxPassword"
                                            behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource NightPasswordBox}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Row="4"
                                        Content="{Binding [ForgotPasswordLabel], Source={StaticResource Localization}}"
                                        Style="{StaticResource NightLinkButton}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="0,4,0,0"
                                        Command="{Binding DataContext.RecoverPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Grid Grid.Row="5" Margin="0,26,0,0">
                                        <Grid VerticalAlignment="Bottom">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding [NoAccountLabel], Source={StaticResource Localization}}"
                                                    Style="{StaticResource NightLabel}"
                                                    FontSize="9"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />
                                                <Button
                                                    Content="{Binding [SignUpButtonLabel], Source={StaticResource Localization}}"
                                                    Style="{StaticResource NightLinkButton}"
                                                    Command="{Binding DataContext.SignUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                            <Button
                                                Content="{Binding [LoginLabel], Source={StaticResource Localization}}"
                                                Style="{StaticResource NightPrimaryButton}"
                                                FontSize="10"
                                                HorizontalAlignment="Right"
                                                Width="220"
                                                Height="50"
                                                IsDefault="True"
                                                Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:strings="clr-namespace:DominoTrainGame.Resources.Localization;assembly=Models"
    x:Class="DominoTrainGame.Views.SettingsWindow"
    Title="{Binding [SettingsLabel], Source={StaticResource Localization}}"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Style="{StaticResource AppWindow}">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False" />
        <Viewbox Style="{StaticResource ScreenViewbox}">
            <Grid Width="1200" Height="820" Margin="0" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Top" Margin="0,6,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource Glacier}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Canvas>
                                        <Rectangle
                                            Fill="{StaticResource DominoLogoBrush}"
                                            Style="{StaticResource PixelArt}"
                                            Width="30"
                                            Height="31" />
                                    </Canvas>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding [GameTitle], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelText}"
                                    FontSize="16" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border
                                Background="{StaticResource Frost}"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="2"
                                Padding="12,9">
                                <TextBlock
                                    Text="{Binding [SettingsLabel], Source={StaticResource Localization}}"
                                    Style="{StaticResource PixelText}"
                                    FontSize="9" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="0,0,4,0">
                                    <Rectangle
                                        Margin="0,364,0,0"
                                        Fill="{StaticResource PixelTrainBrush}"
                                        Style="{StaticResource PixelArt}" />
                                </Border>
                                <Grid Grid.Column="1" Margin="36,28,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="74" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="116" />
                                        <RowDefinition Height="116" />
                                        <RowDefinition Height="54" />
                                        <RowDefinition Height="76" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [SettingsLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource PixelText}"
                                            FontSize="24"
                                            Margin="0,2,0,0" />
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock
                                            Text="{Binding [AudioSectionLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource SectionLabel}"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,18,0" />
                                        <Border
                                            Background="{StaticResource Mint}"
                                            Height="2"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid Grid.Row="2" Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Ink}"
                                            BorderThickness="2"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                            <Rectangle
                                                Margin="8"
                                                Fill="{StaticResource MusicBrush}"
                                                Style="{StaticResource PixelArt}" />
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="{Binding [MusicVolumeLabel], Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelText}"
                                                VerticalAlignment="Center" />
                                            <Border
                                                HorizontalAlignment="Right"
                                                Background="{StaticResource Mist}"
                                                Padding="9,5"
                                                Margin="0,-4,0,0">
                                                <TextBlock Style="{StaticResource PixelText}" FontSize="10">
                                                    <TextBlock.Text>
                                                        <Binding
                                                            Path="Value"
                                                            ElementName="_musicVolumeSlider"
                                                            StringFormat="{x:Static                                                                 strings:UiStrings.VolumePercentageFormat}" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <Slider
                                                x:Name="_musicVolumeSlider"
                                                Value="70"
                                                Style="{StaticResource PixelSlider}"
                                                Margin="0,24,0,22"
                                                Grid.RowSpan="3"
                                                x:FieldModifier="private" />
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Ink}"
                                            BorderThickness="2"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                            <Rectangle
                                                Margin="8"
                                                Fill="{StaticResource SoundBrush}"
                                                Style="{StaticResource PixelArt}" />
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="{Binding [SoundEffectsVolumeLabel], Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelText}"
                                                VerticalAlignment="Center" />
                                            <Border
                                                HorizontalAlignment="Right"
                                                Background="{StaticResource Mist}"
                                                Padding="9,5"
                                                Margin="0,-4,0,0">
                                                <TextBlock Style="{StaticResource PixelText}" FontSize="10">
                                                    <TextBlock.Text>
                                                        <Binding
                                                            Path="Value"
                                                            ElementName="_soundEffectsVolumeSlider"
                                                            StringFormat="{x:Static                                                                 strings:UiStrings.VolumePercentageFormat}" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <Slider
                                                x:Name="_soundEffectsVolumeSlider"
                                                Grid.Row="1"
                                                Value="85"
                                                Style="{StaticResource PixelSlider}"
                                                Margin="0,3,0,18"
                                                Grid.RowSpan="2"
                                                x:FieldModifier="private" />
                                        </Grid>
                                    </Grid>
                                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                                        <TextBlock
                                            Text="{Binding [LanguageSectionLabel], Source={StaticResource Localization}}"
                                            Style="{StaticResource SectionLabel}"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,18,0" />
                                        <Border
                                            Background="{StaticResource Mint}"
                                            Height="2"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            GroupName="Language"
                                            IsChecked="{Binding IsSpanishSelected, Source={StaticResource Localization}, Mode=TwoWay}"
                                            Style="{StaticResource LanguageOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="40"
                                                    Height="40"
                                                    Background="{StaticResource Glacier}"
                                                    BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="2"
                                                    Margin="0,0,14,0">
                                                    <TextBlock
                                                        Text="ES"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="10"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding [SpanishLanguageName], Source={StaticResource Localization}}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="11" />
                                                    <TextBlock
                                                        Text="{Binding [SpanishLanguageDescription], Source={StaticResource Localization}}"
                                                        FontSize="13"
                                                        Margin="0,7,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            Grid.Column="2"
                                            GroupName="Language"
                                            IsChecked="{Binding IsEnglishSelected, Source={StaticResource Localization}, Mode=TwoWay}"
                                            Style="{StaticResource LanguageOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="40"
                                                    Height="40"
                                                    Background="{StaticResource Glacier}"
                                                    BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="2"
                                                    Margin="0,0,14,0">
                                                    <TextBlock
                                                        Text="EN"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="10"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding [EnglishLanguageName], Source={StaticResource Localization}}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="11" />
                                                    <TextBlock
                                                        Text="{Binding [EnglishLanguageDescription], Source={StaticResource Localization}}"
                                                        FontSize="13"
                                                        Margin="0,7,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                    <Grid Grid.Row="6" Margin="0,26,0,0">
                                        <Grid VerticalAlignment="Bottom">
                                            <Button
                                                Content="{Binding [BackButtonLabel], Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelButton}"
                                                HorizontalAlignment="Left"
                                                Width="154"
                                                Height="50"
                                                IsCancel="True"
                                                Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button
                                                Content="{Binding [SaveButtonLabel], Source={StaticResource Localization}}"
                                                Style="{StaticResource PixelButton}"
                                                HorizontalAlignment="Right"
                                                Width="188"
                                                Height="50"
                                                Background="{StaticResource Ink}"
                                                Foreground="{StaticResource Glacier}"
                                                Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

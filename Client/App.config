<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.serviceModel>
    <behaviors>
      <endpointBehaviors>
        <behavior name="SecureClientBehavior">
          <clientCredentials>
            <serviceCertificate>
              <authentication certificateValidationMode="PeerTrust" revocationMode="NoCheck" />
            </serviceCertificate>
          </clientCredentials>
        </behavior>
      </endpointBehaviors>
    </behaviors>
    <bindings>
      <netTcpBinding>
        <binding name="NetTcpBinding_IConnectionService">
          <security mode="Transport">
            <transport clientCredentialType="None" sslProtocols="Tls12" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IAuthenticationService">
          <security mode="Transport">
            <transport clientCredentialType="None" sslProtocols="Tls12" />
          </security>
        </binding>
        <binding name="NetTcpBinding_ILobbyService">
          <security mode="Transport">
            <transport clientCredentialType="None" sslProtocols="Tls12" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IFriendService" receiveTimeout="Infinite">
          <security mode="Transport">
            <transport clientCredentialType="None" sslProtocols="Tls12" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IMatchService">
          <security mode="Transport">
            <transport clientCredentialType="None" sslProtocols="Tls12" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IProfileService" maxReceivedMessageSize="2097152">
          <readerQuotas maxArrayLength="2097152" />
          <security>
            <transport clientCredentialType="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8090/ConnectionService"
        behaviorConfiguration="SecureClientBehavior" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_IConnectionService" contract="DominoService.IConnectionService"
        name="NetTcpBinding_IConnectionService">
        <identity>
          <dns value="DominoTrainGameServer" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/AuthenticationService"
        behaviorConfiguration="SecureClientBehavior" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_IAuthenticationService"
        contract="DominoService.IAuthenticationService" name="NetTcpBinding_IAuthenticationService">
        <identity>
          <dns value="DominoTrainGameServer" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/LobbyService" behaviorConfiguration="SecureClientBehavior"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_ILobbyService"
        contract="DominoService.ILobbyService" name="NetTcpBinding_ILobbyService">
        <identity>
          <dns value="DominoTrainGameServer" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/FriendService" behaviorConfiguration="SecureClientBehavior"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IFriendService"
        contract="DominoService.IFriendService" name="NetTcpBinding_IFriendService">
        <identity>
          <dns value="DominoTrainGameServer" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/MatchService" behaviorConfiguration="SecureClientBehavior"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IMatchService"
        contract="DominoService.IMatchService" name="NetTcpBinding_IMatchService">
        <identity>
          <dns value="DominoTrainGameServer" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/ProfileService" behaviorConfiguration="SecureClientBehavior"
        binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IProfileService"
        contract="DominoService.IProfileService" name="NetTcpBinding_IprofileService">
        <identity>
          <dns value="DominoTrainGameServer" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>

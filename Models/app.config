<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
        <bindings>
            <netTcpBinding>
                <binding name="ConnectionService">
                    <security mode="None">
                        <transport sslProtocols="None" />
                    </security>
                </binding>
                <binding name="AuthenticationService">
                    <security mode="None">
                        <transport sslProtocols="None" />
                    </security>
                </binding>
                <binding name="LobbyService">
                    <security mode="None">
                        <transport sslProtocols="None" />
                    </security>
                </binding>
                <binding name="FriendService">
                    <security mode="None">
                        <transport sslProtocols="None" />
                    </security>
                </binding>
            </netTcpBinding>
        </bindings>
        <client>
            <endpoint address="net.tcp://localhost:8090/ConnectionService"
                binding="netTcpBinding" bindingConfiguration="ConnectionService"
                contract="DominoService.IConnectionService" name="ConnectionService" />
            <endpoint address="net.tcp://localhost:8090/AuthenticationService"
                binding="netTcpBinding" bindingConfiguration="AuthenticationService"
                contract="DominoService.IAuthenticationService" name="AuthenticationService" />
            <endpoint address="net.tcp://localhost:8090/LobbyService" binding="netTcpBinding"
                bindingConfiguration="LobbyService" contract="DominoService.ILobbyService"
                name="LobbyService" />
            <endpoint address="net.tcp://localhost:8090/FriendService" binding="netTcpBinding"
                bindingConfiguration="FriendService" contract="DominoService.IFriendService"
                name="FriendService" />
        </client>
    </system.serviceModel>
</configuration>

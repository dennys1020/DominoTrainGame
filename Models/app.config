<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
        <bindings>
            <netTcpBinding>
                <binding name="NetTcpBinding_IConnectionService">
                    <security>
                        <transport sslProtocols="None" />
                    </security>
                </binding>
                <binding name="NetTcpBinding_IAuthenticationService">
                    <security>
                        <transport sslProtocols="None" />
                    </security>
                </binding>
            </netTcpBinding>
        </bindings>
        <client>
            <endpoint address="net.tcp://localhost:8090/ConnectionService"
                binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IConnectionService"
                contract="DominoService.IConnectionService" name="NetTcpBinding_IConnectionService">
                <identity>
                    <userPrincipalName value="DENNYS\dom99" />
                </identity>
            </endpoint>
            <endpoint address="net.tcp://localhost:8090/AuthenticationService"
                binding="netTcpBinding" bindingConfiguration="NetTcpBinding_IAuthenticationService"
                contract="DominoService.IAuthenticationService" name="NetTcpBinding_IAuthenticationService">
                <identity>
                    <userPrincipalName value="DENNYS\dom99" />
                </identity>
            </endpoint>
        </client>
    </system.serviceModel>
</configuration>
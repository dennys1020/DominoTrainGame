<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://dominotraingame/services" elementFormDefault="qualified" targetNamespace="http://dominotraingame/services" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="GameServiceFault">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" type="tns:GameServiceFaultCode" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="GameServiceFault" nillable="true" type="tns:GameServiceFault" />
  <xs:simpleType name="GameServiceFaultCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="InvalidInput" />
      <xs:enumeration value="DatabaseUnavailable" />
      <xs:enumeration value="SessionNotFound" />
      <xs:enumeration value="LobbyNotFound" />
      <xs:enumeration value="LobbyFull" />
      <xs:enumeration value="LobbyConflict" />
      <xs:enumeration value="AlreadyConnected" />
      <xs:enumeration value="InvalidLobbyRequest" />
      <xs:enumeration value="InvalidSessionToken" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="GameServiceFaultCode" nillable="true" type="tns:GameServiceFaultCode" />
  <xs:complexType name="LoginRequest">
    <xs:sequence>
      <xs:element minOccurs="0" name="Identifier" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Password" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LoginRequest" nillable="true" type="tns:LoginRequest" />
  <xs:complexType name="LoginResponse">
    <xs:sequence>
      <xs:element minOccurs="0" name="IsAuthenticated" type="xs:boolean" />
      <xs:element minOccurs="0" name="PlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="SessionToken" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LoginResponse" nillable="true" type="tns:LoginResponse" />
  <xs:complexType name="SignUpRequest">
    <xs:sequence>
      <xs:element minOccurs="0" name="Email" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Password" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="SignUpRequest" nillable="true" type="tns:SignUpRequest" />
  <xs:complexType name="ConnectRequest">
    <xs:sequence>
      <xs:element minOccurs="0" name="SessionToken" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ConnectRequest" nillable="true" type="tns:ConnectRequest" />
  <xs:complexType name="LobbyResponse">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="HostPlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="MaximumPlayers" type="xs:int" />
      <xs:element minOccurs="0" name="Players" nillable="true" type="tns:ArrayOfLobbyPlayer" />
      <xs:element minOccurs="0" name="Version" type="xs:long" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LobbyResponse" nillable="true" type="tns:LobbyResponse" />
  <xs:complexType name="ArrayOfLobbyPlayer">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="LobbyPlayer" nillable="true" type="tns:LobbyPlayer" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ArrayOfLobbyPlayer" nillable="true" type="tns:ArrayOfLobbyPlayer" />
  <xs:complexType name="LobbyPlayer">
    <xs:sequence>
      <xs:element minOccurs="0" name="IsHost" type="xs:boolean" />
      <xs:element minOccurs="0" name="IsReady" type="xs:boolean" />
      <xs:element minOccurs="0" name="PlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LobbyPlayer" nillable="true" type="tns:LobbyPlayer" />
  <xs:complexType name="JoinLobbyRequest">
    <xs:sequence>
      <xs:element minOccurs="0" name="Code" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="JoinLobbyRequest" nillable="true" type="tns:JoinLobbyRequest" />
  <xs:complexType name="SetReadyRequest">
    <xs:sequence>
      <xs:element minOccurs="0" name="IsReady" type="xs:boolean" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="SetReadyRequest" nillable="true" type="tns:SetReadyRequest" />
  <xs:complexType name="SendLobbyMessageRequest">
    <xs:sequence>
      <xs:element minOccurs="0" name="Text" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="SendLobbyMessageRequest" nillable="true" type="tns:SendLobbyMessageRequest" />
  <xs:complexType name="PlayerJoinedMessage">
    <xs:sequence>
      <xs:element minOccurs="0" name="Player" nillable="true" type="tns:LobbyPlayer" />
      <xs:element minOccurs="0" name="Version" type="xs:long" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="PlayerJoinedMessage" nillable="true" type="tns:PlayerJoinedMessage" />
  <xs:complexType name="PlayerLeftMessage">
    <xs:sequence>
      <xs:element minOccurs="0" name="HostPlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="PlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="Version" type="xs:long" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="PlayerLeftMessage" nillable="true" type="tns:PlayerLeftMessage" />
  <xs:complexType name="PlayerReadyChangedMessage">
    <xs:sequence>
      <xs:element minOccurs="0" name="IsReady" type="xs:boolean" />
      <xs:element minOccurs="0" name="PlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="Version" type="xs:long" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="PlayerReadyChangedMessage" nillable="true" type="tns:PlayerReadyChangedMessage" />
  <xs:complexType name="LobbyChatMessage">
    <xs:sequence>
      <xs:element minOccurs="0" name="PlayerId" type="xs:int" />
      <xs:element minOccurs="0" name="Text" nillable="true" type="xs:string" />
      <xs:element minOccurs="0" name="Username" nillable="true" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:element name="LobbyChatMessage" nillable="true" type="tns:LobbyChatMessage" />
</xs:schema>
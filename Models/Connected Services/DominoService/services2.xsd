      <xs:enumeration value="PlayerBlocked" />
      <xs:enumeration value="FriendRequestNotFound" />
      <xs:enumeration value="NotFriends" />
      <xs:enumeration value="PlayerOffline" />
      <xs:enumeration value="ChatWarning" />
      <xs:enumeration value="ChatBlocked" />
      <xs:enumeration value="PlayerBanned" />
      <xs:enumeration value="MatchNotFound" />
      <xs:enumeration value="NotYourTurn" />
      <xs:enumeration value="TileNotInHand" />
      <xs:enumeration value="TileDoesNotMatch" />
      <xs:enumeration value="TrainNotAvailable" />
      <xs:enumeration value="BoneyardEmpty" />
      <xs:enumeration value="AlreadyDrawn" />
      <xs:enumeration value="MustDrawFirst" />
      <xs:enumeration value="MatchAlreadyStarted" />

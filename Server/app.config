<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="DominoTrainGame.Server.Host.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings configSource="Database.config" />
  <system.net>
    <mailSettings>
      <smtp configSource="Secrets.config" />
    </mailSettings>
  </system.net>
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="GameTcpBinding" closeTimeout="00:00:30" openTimeout="00:00:30"
          sendTimeout="00:00:30">
          <security mode="Transport">
            <transport clientCredentialType="None" sslProtocols="Tls12" />
            <message clientCredentialType="Windows" />
          </security>
        </binding>
        <binding name="GameLobbyTcpBinding" closeTimeout="00:00:30" openTimeout="00:00:30"
          receiveTimeout="Infinite" sendTimeout="00:00:30" maxReceivedMessageSize="65536">
          <security mode="Transport">
            <transport clientCredentialType="None" sslProtocols="Tls12" />
            <message clientCredentialType="Windows" />
          </security>
        </binding>
        <binding name="GameSocialTcpBinding" closeTimeout="00:00:30"
          openTimeout="00:00:30" receiveTimeout="Infinite" sendTimeout="00:00:30"
          maxReceivedMessageSize="65536">
          <security mode="Transport">
            <transport clientCredentialType="None" sslProtocols="Tls12" />
            <message clientCredentialType="Windows" />
          </security>
        </binding>
        <binding name="GameProfileTcpBinding" closeTimeout="00:00:30"
          openTimeout="00:00:30" maxReceivedMessageSize="2097152">
          <readerQuotas maxArrayLength="2097152" />
          <security>
            <transport clientCredentialType="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
          <serviceCredentials>
            <serviceCertificate findValue="DominoTrainGameServer" storeLocation="CurrentUser"
              x509FindType="FindBySubjectName" />
          </serviceCredentials>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service behaviorConfiguration="mexBehavior" name="DominoTrainGame.Server.Service.Implementation.ConnectionService">
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="GameTcpBinding"
          name="ConnectionService" contract="DominoTrainGame.Server.Service.Contracts.IConnectionService" />
        <endpoint address="mex" binding="mexHttpBinding" name="mex" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/ConnectionService" />
            <add baseAddress="http://localhost:8080/ConnectionService" />
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="mexBehavior" name="DominoTrainGame.Server.Service.Implementation.AuthenticationService">
        <endpoint binding="netTcpBinding" bindingConfiguration="GameTcpBinding"
          name="AuthenticationService" contract="DominoTrainGame.Server.Service.Contracts.IAuthenticationService" />
        <endpoint address="mex" binding="mexHttpBinding" bindingConfiguration=""
          name="mex" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/AuthenticationService" />
            <add baseAddress="http://localhost:8080/AuthenticationService" />
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="mexBehavior" name="DominoTrainGame.Server.Service.Implementation.LobbyService">
        <endpoint binding="netTcpBinding" bindingConfiguration="GameLobbyTcpBinding"
          name="LobbyService" contract="DominoTrainGame.Server.Service.Contracts.ILobbyService" />
        <endpoint address="mex" binding="mexHttpBinding" bindingConfiguration=""
          name="mex" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/LobbyService" />
            <add baseAddress="http://localhost:8080/LobbyService" />
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="mexBehavior" name="DominoTrainGame.Server.Service.Implementation.FriendService">
        <endpoint binding="netTcpBinding" bindingConfiguration="GameSocialTcpBinding"
          name="FriendService" contract="DominoTrainGame.Server.Service.Contracts.IFriendService" />
        <endpoint address="mex" binding="mexHttpBinding" bindingConfiguration=""
          name="mex" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/FriendService" />
            <add baseAddress="http://localhost:8080/FriendService" />
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="mexBehavior" name="DominoTrainGame.Server.Service.Implementation.MatchService">
        <endpoint binding="netTcpBinding" bindingConfiguration="GameTcpBinding"
          name="MatchService" contract="DominoTrainGame.Server.Service.Contracts.IMatchService" />
        <endpoint address="mex" binding="mexHttpBinding" bindingConfiguration=""
          name="mex" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090/MatchService" />
            <add baseAddress="http://localhost:8080/MatchService" />
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="mexBehavior" name="DominoTrainGame.Server.Service.GameServices.ProfileService">
        <endpoint binding="netTcpBinding" bindingConfiguration="GameProfileTcpBinding"
          name="ProfileService" contract="DominoTrainGame.Server.Service.Contracts.IProfileService" />
        <endpoint address="mex" binding="mexHttpBinding" bindingConfiguration=""
          name="mex" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8080/ProfileService" />
            <add baseAddress="net.tcp://localhost:8090/ProfileService" />
          </baseAddresses>
        </host>
      </service>
    </services>
  </system.serviceModel>
  <applicationSettings>
    <DominoTrainGame.Server.Host.Properties.Settings>
      <setting name="AvatarFolder" serializeAs="String">
        <value>..\..\Avatars</value>
      </setting>
    </DominoTrainGame.Server.Host.Properties.Settings>
  </applicationSettings>
</configuration>

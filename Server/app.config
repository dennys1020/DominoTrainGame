<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings configSource="Database.config" />
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="GameTcpBinding" closeTimeout="00:00:30" openTimeout="00:00:30"
          sendTimeout="00:00:30" />
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service behaviorConfiguration="mexBehavior" name="DominoTrainGame.Server.Service.Implementation.GameService">
        <endpoint address="ConnectionService" binding="netTcpBinding"
          bindingConfiguration="GameTcpBinding" contract="DominoTrainGame.Server.Service.Contracts.IConnectionService" />
        <endpoint address="AuthenticationService" binding="netTcpBinding"
          bindingConfiguration="GameTcpBinding" contract="DominoTrainGame.Server.Service.Contracts.IAuthenticationService" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8090" />
            <add baseAddress="http://localhost:8080" />
          </baseAddresses>
        </host>
      </service>
    </services>
  </system.serviceModel>
</configuration>

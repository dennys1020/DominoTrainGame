<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.4.0.0" newVersion="3.4.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="NetTcpBinding_IAuthenticationService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_ILeaderboardService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
        <binding name="NetTcpBinding_IVerificationService">
          <security>
            <transport sslProtocols="None" />
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <endpoint address="net.tcp://localhost:8090/GameService" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_IAuthenticationService"
        contract="DominoTrainService.IAuthenticationService"
        name="NetTcpBinding_IAuthenticationService">
        <identity>
          <userPrincipalName value="SAM\sam10" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/GameService" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_ILeaderboardService" contract="DominoTrainService.ILeaderboardService"
        name="NetTcpBinding_ILeaderboardService">
        <identity>
          <userPrincipalName value="SAM\sam10" />
        </identity>
      </endpoint>
      <endpoint address="net.tcp://localhost:8090/GameService" binding="netTcpBinding"
        bindingConfiguration="NetTcpBinding_IVerificationService" contract="DominoTrainService.IVerificationService"
        name="NetTcpBinding_IVerificationService">
        <identity>
          <userPrincipalName value="SAM\sam10" />
        </identity>
      </endpoint>
    </client>
  </system.serviceModel>
</configuration>

<Window
    x:Class="DominoTrainGame.Views.RecoverPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:DominoTrainGame.Behaviors"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels;assembly=DominoTrainGame.Client.ViewModels"
    Title="{Binding WindowTitles[RecoverPasswordTitle]}"
    Width="460"
    Height="480"
    MinWidth="380"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    ShowInTaskbar="False">
    <Window.Resources><BooleanToVisibilityConverter x:Key="StepVisibility" /></Window.Resources>
    <Grid Margin="24">
        <Border
            Background="{StaticResource Glacier}"
            BorderBrush="{StaticResource Ink}"
            BorderThickness="2"
            Padding="20">
            <StackPanel VerticalAlignment="Center" Margin="0,0,1,0">
                <TextBlock
                    Text="{Binding Uppercase[RecoverPasswordTitle]}"
                    Style="{StaticResource PixelText}"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20" />
                <StackPanel x:Name="IdentifyStep" Visibility="{Binding IsIdentifyStep, Converter={StaticResource StepVisibility}}">
                    <TextBlock
                        Text="{Binding Uppercase[EmailOrUsernameLabel]}"
                        Style="{StaticResource SectionLabel}"
                        Margin="0,0,0,4" />
                    <TextBox
                        x:Name="EmailOrUsernameTextBox" Text="{Binding Identifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Height="36"
                        FontFamily="Consolas"
                        FontSize="13"
                        Padding="8"
                        Margin="0,0,0,20" />
                    <Button
                        x:Name="SendCodeButton"
                        Content="{Binding Uppercase[SendCodeButtonLabel]}"
                        Style="{StaticResource PixelButton}"
                        Height="50"
                        Width="253"
                        Command="{Binding DataContext.SendCodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <!-- Paso 2: nueva contraseña (oculto hasta verificar el código) -->
                <StackPanel x:Name="NewPasswordStep" Visibility="{Binding IsPasswordStep, Converter={StaticResource StepVisibility}}">
                    <TextBlock
                        Text="{Binding Uppercase[NewPasswordLabel]}"
                        Style="{StaticResource SectionLabel}"
                        Margin="0,0,0,4" />
                    <PasswordBox
                        x:Name="NewPasswordBox" behaviors:PasswordBinding.IsEnabled="True" behaviors:PasswordBinding.Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Height="36"
                        FontFamily="Consolas"
                        FontSize="13"
                        Padding="8"
                        Margin="0,0,0,16" />
                    <TextBlock
                        Text="{Binding Uppercase[ConfirmPasswordLabel]}"
                        Style="{StaticResource SectionLabel}"
                        Margin="0,0,0,4" />
                    <PasswordBox
                        x:Name="ConfirmPasswordBox" behaviors:PasswordBinding.IsEnabled="True" behaviors:PasswordBinding.Password="{Binding Confirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Height="36"
                        FontFamily="Consolas"
                        FontSize="13"
                        Padding="8"
                        Margin="0,0,0,20" />
                    <Button
                        Content="{Binding Uppercase[ChangePasswordLabel]}"
                        Style="{StaticResource PixelButton}"
                        Height="50"
                        Width="253"
                        Command="{Binding DataContext.UpdatePasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
                <TextBlock
                    x:Name="TextBlockMessage" Text="{Binding Message}"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Margin="0,16,0,0"
                    AutomationProperties.LiveSetting="Polite" />
                <Button
                    Content="{Binding Uppercase[CancelButtonLabel]}"
                    Style="{StaticResource PixelButton}"
                    Height="50"
                    Width="253"
                    Padding="8"
                    Margin="0,18,0,0"
                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

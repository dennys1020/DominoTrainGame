<UserControl
    x:Class="DominoTrainGame.Views.Controls.SettingsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels;assembly=DominoTrainGame.Client.ViewModels"
    >
    <Button Style="{StaticResource MenuIconButton}" Command="{Binding}" ToolTip="{Binding Uppercase[SettingsLabel], Source={StaticResource Localization}}">
        <Image Source="{StaticResource MenuSettingsImage}" Width="36" Height="36" />
    </Button>
</UserControl>

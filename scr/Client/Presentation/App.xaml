<Application
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels;assembly=DominoTrainGame.Client.ViewModels"
    x:Class="DominoTrainGame.App"
    StartupUri="Views/LogInWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/PixelTheme.xaml" />
                <ResourceDictionary Source="Resources/Styles/MatchStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Static x:Key="Localization" Member="viewModels:LocalizationViewModel.Instance" />
            <BitmapImage x:Key="DefaultAvatar" UriSource="/Resources/Images/avatar_generic_preview.png" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

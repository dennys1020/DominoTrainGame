<Window
    x:Class="DominoTrainGame.Views.RecoverPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [RecoverPasswordWindowTitle]}"
    Width="460"
    Height="480"
    MinWidth="380"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    ShowInTaskbar="False">
    <Grid Margin="24">
        <Border
            Background="{StaticResource Glacier}"
            BorderBrush="{StaticResource Ink}"
            BorderThickness="2"
            Padding="20">
            <StackPanel VerticalAlignment="Center" Margin="0,0,1,0">
                <TextBlock
                    Text="{Binding [RecoverPasswordFormTitle]}"
                    Style="{StaticResource PixelText}"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20" />
                <StackPanel x:Name="IdentifyStep">
                    <TextBlock
                        Text="{Binding [EmailOrUsernameLabel]}"
                        Style="{StaticResource SectionLabel}"
                        Margin="0,0,0,4" />
                    <TextBox
                        x:Name="EmailOrUsernameTextBox"
                        Height="36"
                        FontFamily="Consolas"
                        FontSize="13"
                        Padding="8"
                        Margin="0,0,0,20" />
                    <Button
                        x:Name="SendCodeButton"
                        Content="{Binding [SendCodeButtonLabel]}"
                        Style="{StaticResource PixelButton}"
                        Height="50"
                        Width="253"
                        Click="OnSendCodeButtonClicked" />
                </StackPanel>
                <!-- Paso 2: nueva contraseña (oculto hasta verificar el código) -->
                <StackPanel x:Name="NewPasswordStep" Visibility="Collapsed">
                    <TextBlock
                        Text="{Binding [NewPasswordLabel]}"
                        Style="{StaticResource SectionLabel}"
                        Margin="0,0,0,4" />
                    <PasswordBox
                        x:Name="NewPasswordBox"
                        Height="36"
                        FontFamily="Consolas"
                        FontSize="13"
                        Padding="8"
                        Margin="0,0,0,16" />
                    <TextBlock
                        Text="{Binding [ConfirmPasswordLabel]}"
                        Style="{StaticResource SectionLabel}"
                        Margin="0,0,0,4" />
                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Height="36"
                        FontFamily="Consolas"
                        FontSize="13"
                        Padding="8"
                        Margin="0,0,0,20" />
                    <Button
                        Content="{Binding [ChangePasswordButtonLabel]}"
                        Style="{StaticResource PixelButton}"
                        Height="50"
                        Width="253"
                        Click="OnUpdatePasswordButtonClicked" />
                </StackPanel>
                <TextBlock
                    x:Name="TextBlockMessage"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Margin="0,16,0,0"
                    AutomationProperties.LiveSetting="Polite" />
                <Button
                    Content="{Binding [CancelButtonLabel]}"
                    Style="{StaticResource PixelButton}"
                    Height="50"
                    Width="253"
                    Padding="8"
                    Margin="0,18,0,0"
                    Click="OnCancelButtonClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<UserControl
    x:Class="DominoTrainGame.Views.Controls.SettingsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}">
    <Button Style="{StaticResource MenuIconButton}" Click="OpenSettings"
            ToolTip="{Binding [OpenSettingsButtonLabel]}">
        <Image Source="{StaticResource MenuSettingsImage}" Width="36" Height="36" />
    </Button>
</UserControl>

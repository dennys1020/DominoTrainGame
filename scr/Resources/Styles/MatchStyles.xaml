<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="MatchWindow" TargetType="Window">
        <Setter Property="Width" Value="1220" />
        <Setter Property="Height" Value="860" />
        <Setter Property="MinWidth" Value="960" />
        <Setter Property="MinHeight" Value="700" />
        <Setter Property="Background" Value="{StaticResource Glacier}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="MatchCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Glacier}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="Padding" Value="30" />
    </Style>
    <Style x:Key="MatchHeading" TargetType="TextBlock" BasedOn="{StaticResource PixelText}">
        <Setter Property="FontSize" Value="23" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="34" />
    </Style>
    <Style x:Key="MatchBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="26" />
    </Style>
    <Style x:Key="MatchSection" TargetType="TextBlock" BasedOn="{StaticResource PixelText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="MatchButton" TargetType="Button" BasedOn="{StaticResource PixelButton}">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="20,14" />
    </Style>
    <Style x:Key="MatchDoubleOption" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="OptionSurface" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource Glacier}" BorderBrush="{StaticResource Ink}"
                            BorderThickness="2">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OptionSurface" Property="Background" Value="{StaticResource Frost}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OptionSurface" Property="Background" Value="{StaticResource Aqua}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="OptionSurface" Property="BorderBrush" Value="{StaticResource Aqua}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MatchInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Mist}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Frost}" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="InputSurface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InputSurface" Property="Background" Value="{StaticResource Frost}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="MatchTableCell" TargetType="TextBlock" BasedOn="{StaticResource MatchBody}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="FontSize" Value="22" />
    </Style>
    <DrawingImage x:Key="MatchDominoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Ink}" Geometry="M0,0 H48 V84 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Glacier}" Geometry="M4,4 H44 V80 H4 Z" />
                <GeometryDrawing Brush="{StaticResource Mint}" Geometry="M8,40 H40 V44 H8 Z" />
                <GeometryDrawing Brush="{StaticResource Ink}"
                    Geometry="M10,10 H17 V17 H10 Z M31,27 H38 V34 H31 Z M10,50 H17 V57 H10 Z
                              M31,50 H38 V57 H31 Z M20,60 H27 V67 H20 Z M10,70 H17 V77 H10 Z
                              M31,70 H38 V77 H31 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="MatchTrophyImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H96 V96 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Ink}"
                    Geometry="M22,8 H74 V20 H90 V45 H80 V55 H66 V65 H54 V76 H70 V88 H26 V76 H42
                              V65 H30 V55 H16 V45 H6 V20 H22 Z" />
                <GeometryDrawing Brush="{StaticResource Aqua}"
                    Geometry="M28,14 H68 V43 H60 V54 H36 V43 H28 Z M12,26 H22 V43 H16 V39 H12 Z
                              M74,26 H84 V39 H80 V43 H74 Z M32,81 H64 V84 H32 Z" />
                <GeometryDrawing Brush="{StaticResource Glacier}"
                    Geometry="M44,22 H52 V29 H59 V37 H52 V44 H44 V37 H37 V29 H44 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>

<Window
    x:Class="DominoTrainGame.Views.VerificationCodeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [VerificationWindowTitle]}"
    Width="1220"
    Height="880"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    ShowInTaskbar="False"
    FocusManager.FocusedElement="{Binding ElementName=_codeBox1}">
    <Window.Resources>
        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="80" />
            <Setter Property="MaxLength" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Frost}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{StaticResource Mist}"
                            BorderBrush="{StaticResource Mint}"
                            BorderThickness="2">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource Glacier}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonDangerStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="820" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,6,8,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource Glacier}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Path
                                        Fill="{StaticResource Ink}"
                                        Data="M5,5 H11 V11 H5 Z M19,5 H25 V11 H19 Z M0,16 H30 V19 H0 Z M12,25 H18 V31 H12 Z" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="{Binding [GameTitle]}"
                                Style="{StaticResource PixelText}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button
                            Content="{Binding [OpenSettingsButtonLabel]}"
                            Style="{StaticResource PixelButton}"
                            Height="46"
                            HorizontalAlignment="Right"
                            Click="OpenSettings" />
                            <Button
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseWindow_Click">
                                <Path
                                Stroke="{StaticResource Glacier}"
                                StrokeThickness="3"
                                Data="M4,4 L16,16 M16,4 L4,16"
                                Width="20"
                                Height="20"
                                Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="0,0,4,0">
                                    <Grid ClipToBounds="True">
                                        <StackPanel Margin="24,30,24,0" VerticalAlignment="Top">
                                            <Image
                                            Source="pack://application:,,,/Resources/Images/PixelEnvelope.png"
                                            Width="80"
                                            Height="88"
                                            HorizontalAlignment="Left"
                                            Margin="0,30,0,24"
                                            Stretch="Uniform"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            IsHitTestVisible="False" />
                                        </StackPanel>
                                        <Image
                                            Source="pack://application:,,,/Resources/Images/PixelTrain.png"
                                            Height="242"
                                            Stretch="UniformToFill"
                                            VerticalAlignment="Top"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            IsHitTestVisible="False"
                                            Margin="0,394,0,0" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" Margin="36,30,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="96" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="54" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Text="{Binding [VerificationTitle]}"
                                        Style="{StaticResource PixelText}"
                                        FontSize="23" />

                                    <StackPanel Grid.Row="1">
                                        <TextBlock
                                            Text="{Binding [VerificationPrompt]}"
                                            TextWrapping="Wrap"
                                            FontSize="14"
                                            Margin="0,0,0,28" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                            <TextBox x:Name="_codeBox1" x:FieldModifier="private" Style="{StaticResource CodeBox}"
                                                     TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                                            <TextBox x:Name="_codeBox2" x:FieldModifier="private" Style="{StaticResource CodeBox}"
                                                     TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                                            <TextBox x:Name="_codeBox3" x:FieldModifier="private" Style="{StaticResource CodeBox}"
                                                     TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                                            <TextBox x:Name="_codeBox4" x:FieldModifier="private" Style="{StaticResource CodeBox}"
                                                     TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                                            <TextBox x:Name="_codeBox5" x:FieldModifier="private" Style="{StaticResource CodeBox}"
                                                     Margin="0"
                                                     TextChanged="CodeBox_TextChanged" PreviewKeyDown="CodeBox_PreviewKeyDown" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Margin="0,32,0,16">
                                        <TextBlock HorizontalAlignment="Center" FontSize="14">
                                            <Run Text="{Binding [VerificationNoEmail], Mode=OneWay}" />
                                            <Hyperlink Click="ResendCode_Click">
                                                <Run Text="{Binding [ButtonResendCode], Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <Button
                                            Content="{Binding [ButtonVerify]}"
                                            Style="{StaticResource PixelButton}"
                                            Background="{StaticResource Ink}"
                                            Foreground="{StaticResource Glacier}"
                                            Width="248"
                                            HorizontalAlignment="Center"
                                            IsDefault="True"
                                            Click="Verify_Click"  />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

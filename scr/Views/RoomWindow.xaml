<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DominoTrainGame.Views.Controls"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    xmlns:strings="clr-namespace:DominoTrainGame.Resources.Localization"
    x:Class="DominoTrainGame.Views.RoomWindow"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [RoomWindowTitle]}"
    Style="{StaticResource MatchWindow}"
    WindowStartupLocation="CenterScreen"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="HostVisibility" />
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image
                                Source="{StaticResource MatchDominoImage}"
                                Width="24"
                                Height="42"
                                Margin="0,0,16,0" />
                            <TextBlock
                                Text="{Binding [GameTitle]}"
                                Style="{StaticResource PixelText}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:SettingsButton HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCard}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="68" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding [RoomTitle]}" Style="{StaticResource MatchHeading}" />
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="370" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel
                                            Visibility="{Binding IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HostVisibility}}"
                                            d:Visibility="Visible">
                                            <TextBlock
                                                Text="{Binding [RoomCodeLabel]}"
                                                Style="{StaticResource MatchSection}" />
                                            <Border
                                                Background="{StaticResource Frost}"
                                                BorderBrush="{StaticResource Ink}"
                                                BorderThickness="2"
                                                Padding="18,19">
                                                <TextBlock
                                                    Text="{Binding [SampleRoomCode]}"
                                                    Style="{StaticResource PixelText}"
                                                    FontSize="26"
                                                    HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock
                                                Text="{Binding [RoomCodeDescription]}"
                                                Style="{StaticResource MatchBody}"
                                                Margin="0,10,0,24"
                                                FontSize="16" />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding [MaximumDoubleLabel]}"
                                            Style="{StaticResource MatchSection}" />
                                        <UniformGrid
                                            Rows="1"
                                            Visibility="{Binding IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HostVisibility}}"
                                            IsEnabled="{Binding IsHost, RelativeSource={RelativeSource AncestorType=Window}}"
                                            d:Visibility="Visible"
                                            d:IsEnabled="True">
                                            <RadioButton
                                                Content="{Binding [Double6Label]}"
                                                GroupName="MaximumDouble"
                                                Style="{StaticResource MatchDoubleOption}"
                                                Margin="0,0,10,0"
                                                FontSize="20"
                                                Padding="18,20"
                                                IsChecked="{Binding Room.IsDoubleSixSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                d:IsChecked="False" />
                                            <RadioButton
                                                Content="{Binding [Double9Label]}"
                                                GroupName="MaximumDouble"
                                                Style="{StaticResource MatchDoubleOption}"
                                                Margin="0,0,10,0"
                                                FontSize="20"
                                                Padding="18,20"
                                                IsChecked="{Binding Room.IsDoubleNineSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                d:IsChecked="False" />
                                            <RadioButton
                                                Content="{Binding [Double12Label]}"
                                                GroupName="MaximumDouble"
                                                Style="{StaticResource MatchDoubleOption}"
                                                Margin="0,0,10,0"
                                                FontSize="20"
                                                Padding="18,20"
                                                IsChecked="{Binding Room.IsDoubleTwelveSelected, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                d:IsChecked="True" />
                                        </UniformGrid>
                                        <Border
                                            Background="{StaticResource Mist}"
                                            Padding="18,20"
                                            d:Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsHost, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock
                                                    Text="{Binding Room.MaximumDouble, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource PixelText}"
                                                    FontSize="24"
                                                    HorizontalAlignment="Center" />
                                                <TextBlock
                                                    Text="{Binding [MaximumDoubleReadOnlyDescription]}"
                                                    Style="{StaticResource MatchBody}"
                                                    Margin="0,12,0,0"
                                                    FontSize="16"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock
                                            Text="{Binding [MaximumDoubleDescription]}"
                                            Style="{StaticResource MatchBody}"
                                            Margin="0,12,0,0"
                                            FontSize="16" />
                                    </StackPanel>
                                    <Grid
                                        Grid.Column="2"
                                        DataContext="{Binding Room, RelativeSource={RelativeSource AncestorType=Window}}"
                                        d:DataContext="{d:DesignInstance Type=viewModels:RoomViewModel, IsDesignTimeCreatable=True}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="35" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Text="{Binding [PlayersLabel], Source={x:Static viewModels:LocalizationViewModel.Instance}}"
                                            Style="{StaticResource MatchSection}" />
                                        <TextBlock
                                            Style="{StaticResource PixelText}"
                                            HorizontalAlignment="Right"
                                            FontSize="13">
                                            <TextBlock.Text>
                                                <MultiBinding
                                                    StringFormat="{x:Static strings:UiStrings.RoomPlayerCountFormat}">
                                                    <Binding Path="Players.Count" />
                                                    <Binding Path="MaximumPlayers" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <ScrollViewer
                                            Grid.Row="1"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Players}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            BorderBrush="{StaticResource Mint}"
                                                            BorderThickness="0,0,0,2"
                                                            Padding="12,10">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter
                                                                        Property="Background"
                                                                        Value="{StaticResource Glacier}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger
                                                                            Binding="{Binding IsCurrentPlayer}"
                                                                            Value="True">
                                                                            <Setter
                                                                                Property="Background"
                                                                                Value="{StaticResource Mist}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid MinHeight="52">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image
                                                                    Source="/Resources/Images/avatar_generic_preview.png"
                                                                    Width="30"
                                                                    Height="34"
                                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                    HorizontalAlignment="Left" />
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,12,0">
                                                                    <TextBlock
                                                                        ToolTip="{Binding Username}"
                                                                        FontSize="19">
                                                                        <TextBlock.Style>
                                                                            <Style
                                                                                TargetType="TextBlock"
                                                                                BasedOn="{StaticResource MatchBody}">
                                                                                <Setter
                                                                                    Property="Text"
                                                                                    Value="{Binding Username}" />
                                                                                <Style.Triggers>
                                                                                    <MultiDataTrigger>
                                                                                        <MultiDataTrigger.Conditions>
                                                                                            <Condition
                                                                                                Binding="{Binding IsCurrentPlayer}"
                                                                                                Value="True" />
                                                                                            <Condition
                                                                                                Binding="{Binding Username}"
                                                                                                Value="" />
                                                                                        </MultiDataTrigger.Conditions>
                                                                                        <Setter
                                                                                            Property="Text"
                                                                                            Value="{Binding [YouPlayerLabel], Source={x:Static viewModels:LocalizationViewModel.Instance}}" />
                                                                                    </MultiDataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock
                                                                        Text="{Binding [RoomHostLabel], Source={x:Static viewModels:LocalizationViewModel.Instance}}">
                                                                        <TextBlock.Style>
                                                                            <Style
                                                                                TargetType="TextBlock"
                                                                                BasedOn="{StaticResource PixelText}">
                                                                                <Setter Property="FontSize" Value="9" />
                                                                                <Setter
                                                                                    Property="Margin"
                                                                                    Value="0,6,0,0" />
                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsHost}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Visibility"
                                                                                            Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Right"
                                                                        Margin="0,0,0,6">
                                                                        <TextBlock.Style>
                                                                            <Style
                                                                                TargetType="TextBlock"
                                                                                BasedOn="{StaticResource PixelText}">
                                                                                <Setter Property="FontSize" Value="9" />
                                                                                <Setter
                                                                                    Property="Text"
                                                                                    Value="{Binding [RoomNotReadyLabel], Source={x:Static viewModels:LocalizationViewModel.Instance}}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsReady}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Text"
                                                                                            Value="{Binding [ReadyStatusLabel], Source={x:Static viewModels:LocalizationViewModel.Instance}}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button
                                                                        Content="{Binding [MarkReadyButtonLabel], Source={x:Static viewModels:LocalizationViewModel.Instance}}"
                                                                        Click="MarkReady"
                                                                        MinWidth="180"
                                                                        FontSize="9">
                                                                        <Button.Style>
                                                                            <Style
                                                                                TargetType="Button"
                                                                                BasedOn="{StaticResource MatchButton}">
                                                                                <Setter
                                                                                    Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsCurrentPlayer}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Visibility"
                                                                                            Value="Visible" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsReady}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="IsEnabled"
                                                                                            Value="False" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Border
                                            Grid.Row="1"
                                            Background="{StaticResource Mist}"
                                            Padding="20"
                                            VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Players.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                Text="{Binding [RoomNoPlayersLabel], Source={x:Static viewModels:LocalizationViewModel.Instance}}"
                                                Style="{StaticResource MatchBody}"
                                                FontSize="16" />
                                        </Border>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Button
                                        Content="{Binding [StartMatchButtonLabel]}"
                                        Style="{StaticResource MatchButton}"
                                        Click="OpenResults"
                                        HorizontalAlignment="Right"
                                        Width="270"
                                        Background="{StaticResource Aqua}"
                                        Visibility="{Binding IsHost, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HostVisibility}}"
                                        IsEnabled="{Binding IsHost, RelativeSource={RelativeSource AncestorType=Window}}"
                                        d:Visibility="Visible"
                                        d:IsEnabled="True" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,8,4">
                        <Button
                            Content="{Binding [BackButtonLabel]}"
                            Style="{StaticResource MatchButton}"
                            Click="NavigateBack"
                            HorizontalAlignment="Left"
                            MinWidth="170" />
                        <Button
                            Content="{Binding [GameRulesButtonLabel]}"
                            Style="{StaticResource MatchButton}"
                            Click="OpenRules"
                            HorizontalAlignment="Right"
                            MinWidth="210" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

<Window
    x:Class="DominoTrainGame.Views.LeaderBoardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    Title="{Binding Localization[LeaderboardWindowTitle]}"
    Width="960" Height="700" MinWidth="740" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
    Loaded="OnLoaded" Closed="OnClosed">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Localization[LeaderboardTitle]}"
                   Style="{StaticResource PixelText}" FontSize="22" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="{Binding Localization[LeaderboardExplanation]}"
                   Foreground="{StaticResource Ink}" FontSize="14"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Content="{Binding Localization[LeaderboardFilterLabel]}" Target="{Binding ElementName=PlayerFilter}"
                   VerticalAlignment="Center" Foreground="{StaticResource Ink}" Margin="0,0,12,0"/>
            <TextBox x:Name="PlayerFilter" Grid.Column="1" MaxLength="45" Padding="8"
                     VerticalContentAlignment="Center" FontSize="14"
                     Text="{Binding PlayerFilter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding Localization[LeaderboardFilterLabel]}"/>
            <Button Grid.Column="2" Content="{Binding Localization[LeaderboardRefreshButtonLabel]}"
                    Style="{StaticResource PixelButton}" Margin="16,0,0,0"
                    IsEnabled="{Binding CanRefresh}" Click="RefreshLeaderboard"/>
        </Grid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Entries}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                  CanUserReorderColumns="False" HeadersVisibility="Column" RowHeaderWidth="0"
                  Background="{StaticResource Glacier}" Foreground="{StaticResource Ink}"
                  BorderBrush="{StaticResource Ink}" BorderThickness="2"
                  RowBackground="White" AlternatingRowBackground="{StaticResource Mist}"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Mint}"
                  FontSize="14" RowHeight="42" ColumnHeaderHeight="48"
                  AutomationProperties.Name="{Binding Localization[LeaderboardTitle]}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Glacier}"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Rank}" SortMemberPath="Rank" Width="100"
                    Header="{Binding [LeaderboardRankHeader],
                        Source={x:Static viewModels:LocalizationViewModel.Instance}}"/>
                <DataGridTextColumn Binding="{Binding Username}" SortMemberPath="Username" Width="*" MinWidth="170"
                    Header="{Binding [LeaderboardPlayerHeader],
                        Source={x:Static viewModels:LocalizationViewModel.Instance}}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Username}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Wins}" SortMemberPath="Wins" Width="110"
                    Header="{Binding [LeaderboardWinsHeader],
                        Source={x:Static viewModels:LocalizationViewModel.Instance}}"/>
                <DataGridTextColumn Binding="{Binding GamesPlayed}" SortMemberPath="GamesPlayed" Width="110"
                    Header="{Binding [LeaderboardGamesHeader],
                        Source={x:Static viewModels:LocalizationViewModel.Instance}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{StaticResource Ink}"
                   FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>

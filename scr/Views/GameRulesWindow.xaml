<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DominoTrainGame.Views.Controls"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    x:Class="DominoTrainGame.Views.GameRulesWindow"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [GameRulesWindowTitle]}"
    Style="{StaticResource MatchWindow}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image
                                Source="{StaticResource MatchDominoImage}"
                                Width="24"
                                Height="42"
                                Margin="0,0,16,0" />
                            <TextBlock
                                Text="{Binding [GameTitle]}"
                                Style="{StaticResource PixelText}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:SettingsButton HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCard}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding [GameRulesTitle]}"
                                        Style="{StaticResource MatchHeading}" />
                                </StackPanel>
                                <ScrollViewer
                                    Grid.Row="1"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    PanningMode="VerticalOnly"
                                    Padding="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Grid.Row="0"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesObjectiveTitle]}"
                                                        Style="{StaticResource MatchSection}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesObjectiveDescription]}"
                                                        Style="{StaticResource MatchBody}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Grid.Row="0"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesPreparationTitle]}"
                                                        Style="{StaticResource MatchSection}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesPreparationDescription]}"
                                                        Style="{StaticResource MatchBody}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="0"
                                            Grid.Row="1"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesTurnTitle]}"
                                                        Style="{StaticResource MatchSection}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesTurnDescription]}"
                                                        Style="{StaticResource MatchBody}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Grid.Row="1"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesDrawTitle]}"
                                                        Style="{StaticResource MatchSection}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesDrawDescription]}"
                                                        Style="{StaticResource MatchBody}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="0"
                                            Grid.Row="2"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesDoublesTitle]}"
                                                        Style="{StaticResource MatchSection}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesDoublesDescription]}"
                                                        Style="{StaticResource MatchBody}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Grid.Column="1"
                                            Grid.Row="2"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Mint}"
                                            BorderThickness="2"
                                            Margin="0,0,16,16"
                                            Padding="16">
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        Text="{Binding [RulesScoringTitle]}"
                                                        Style="{StaticResource MatchSection}"
                                                        FontSize="12" />
                                                    <TextBlock
                                                        Text="{Binding [RulesScoringDescription]}"
                                                        Style="{StaticResource MatchBody}"
                                                        FontSize="16"
                                                        LineHeight="22" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,8,4">
                        <Button
                            Content="{Binding [BackButtonLabel]}"
                            Style="{StaticResource MatchButton}"
                            Click="NavigateBack"
                            HorizontalAlignment="Left"
                            MinWidth="170" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

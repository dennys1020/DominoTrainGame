<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DominoTrainGame.Views.Controls"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    x:Class="DominoTrainGame.Views.NewGameWindow"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [NewGameWindowTitle]}"
    Style="{StaticResource MatchWindow}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image
                                Source="{StaticResource MatchDominoImage}"
                                Width="24"
                                Height="42"
                                Margin="0,0,16,0" />
                            <TextBlock
                                Text="{Binding [GameTitle]}"
                                Style="{StaticResource PixelText}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:SettingsButton HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCard}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding [NewGameTitle]}" Style="{StaticResource MatchHeading}" />
                                    <TextBlock
                                        Text="{Binding [NewGameDescription]}"
                                        Style="{StaticResource MatchBody}"
                                        Margin="0,12,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource MatchCard}" Background="{StaticResource Mist}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100" />
                                                <RowDefinition Height="50" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="60" />
                                            </Grid.RowDefinitions>
                                            <Image
                                                Source="{StaticResource MatchDominoImage}"
                                                Width="44"
                                                Height="77"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top" />
                                            <TextBlock
                                                Text="{Binding [CreateGameTitle]}"
                                                Style="{StaticResource MatchHeading}"
                                                Grid.Row="1"
                                                FontSize="19" />
                                            <TextBlock
                                                Text="{Binding [CreateGameDescription]}"
                                                Style="{StaticResource MatchBody}"
                                                Grid.Row="2"
                                                Margin="0,8,0,20" />
                                            <Button
                                                Content="{Binding [CreateGameButtonLabel]}"
                                                Style="{StaticResource MatchButton}"
                                                Click="OpenGameSetup"
                                                Grid.Row="3"
                                                Background="{StaticResource Aqua}" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        Grid.Column="2"
                                        Style="{StaticResource MatchCard}"
                                        Background="{StaticResource Mist}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100" />
                                                <RowDefinition Height="50" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="60" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                                <Image
                                                    Source="{StaticResource MatchDominoImage}"
                                                    Width="44"
                                                    Height="77" />
                                                <Image
                                                    Source="{StaticResource MatchDominoImage}"
                                                    Width="44"
                                                    Height="77"
                                                    Margin="14,0,0,0" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{Binding [JoinGameTitle]}"
                                                Style="{StaticResource MatchHeading}"
                                                Grid.Row="1"
                                                FontSize="19" />
                                            <TextBlock
                                                Text="{Binding [JoinGameDescription]}"
                                                Style="{StaticResource MatchBody}"
                                                Grid.Row="2"
                                                Margin="0,8,0,20" />
                                            <Button
                                                Content="{Binding [JoinGameButtonLabel]}"
                                                Style="{StaticResource MatchButton}"
                                                Click="OpenJoinGame"
                                                Grid.Row="3"
                                                Background="{StaticResource Frost}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,8,4">
                        <Button
                            Content="{Binding [BackButtonLabel]}"
                            Style="{StaticResource MatchButton}"
                            Click="NavigateBack"
                            HorizontalAlignment="Left"
                            MinWidth="170" />
                        <Button
                            Content="{Binding [GameRulesButtonLabel]}"
                            Style="{StaticResource MatchButton}"
                            Click="OpenRules"
                            HorizontalAlignment="Right"
                            MinWidth="210" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

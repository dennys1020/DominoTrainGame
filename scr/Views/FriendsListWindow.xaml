<Window
    x:Class="DominoTrainGame.Views.FriendsListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [FriendListWindowTitle]}"
    Width="1200"
    Height="880"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="FriendsTab" Grid.Column="0" GroupName="Tabs"
                Content="{Binding [TabFriends]}"
                Style="{StaticResource TabButtonStyle}"
                IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="RequestsTab" Grid.Column="1" GroupName="Tabs"
                Content="{Binding [TabRequests]}"
                Style="{StaticResource TabButtonStyle}"
                Checked="Tab_Checked"/>
        </Grid>

        <StackPanel x:Name="FriendsPanel" Grid.Row="1" Margin="0,20,0,0">
            <Border Background="{StaticResource Glacier}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="2" Padding="16" Margin="0,0,0,16">
                <ItemsControl x:Name="FriendsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource Ink}"
                                    BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Username}"
                                               Style="{StaticResource PixelText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}"
                                               Style="{StaticResource SectionLabel}" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="{Binding DataContext.ButtonRemove,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource PixelButtonDangerStyle}"
                                            Click="RemoveFriend_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Background="{StaticResource Aqua}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="2" Padding="16">
                <StackPanel>
                    <TextBox x:Name="SearchUserTextBox" Height="40" Margin="0,0,0,10"
                             FontFamily="Consolas" FontSize="14" Padding="8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding [ButtonAdd]}"
                                Style="{StaticResource PixelButton}"
                                Click="AddFriend_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="RequestsPanel" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
            <Border Background="{StaticResource Glacier}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="2" Padding="16">
                <ItemsControl x:Name="RequestsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource Ink}"
                                    BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Username}"
                                               Style="{StaticResource PixelText}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{Binding DataContext[ButtonAccept],
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource PixelButton}"
                                            Margin="0,0,8,0" Click="AcceptRequest_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="2" Content="{Binding DataContext.ButtonReject,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                            Style="{StaticResource PixelButtonDangerStyle}"
                                            Click="RejectRequest_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Grid>
</Window>
<Window
    x:Class="DominoTrainGame.Views.FriendsListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [FriendsListWindowTitle]}"
    Width="1200"
    Height="880"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    ShowInTaskbar="False">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="FriendsTab" Grid.Column="0" GroupName="Tabs"
                Content="{Binding [TabFriends]}"
                Style="{StaticResource TabButtonStyle}"
                IsChecked="True" Checked="Tab_Checked"/>
            <RadioButton x:Name="RequestsTab" Grid.Column="1" GroupName="Tabs"
                Content="{Binding [TabRequests]}"
                Style="{StaticResource TabButtonStyle}"
                Checked="Tab_Checked"/>
        </Grid>

        <StackPanel x:Name="FriendsPanel" Grid.Row="1" Margin="0,20,0,0">
            <Border Background="{StaticResource Glacier}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="2" Padding="16" Margin="0,0,0,16">
                <ItemsControl>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource Ink}"
                                    BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="/Resources/Images/person.png" Width="18" Height="18" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Username}"
                                                   Style="{StaticResource PixelText}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Status}"
                                               Style="{StaticResource SectionLabel}" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="2" Style="{StaticResource PixelButtonDangerStyle}"
                                            Click="RemoveFriend_Click" Tag="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Images/trash.png" Width="14" Height="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DataContext.[ButtonRemove],
                                                RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Background="{StaticResource Aqua}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="2" Padding="16">
                <StackPanel>
                    <Grid>
                        <TextBox Height="40"
                                 FontFamily="Consolas" FontSize="14" Padding="34,8,8,8"/>
                        <Image Source="/Resources/Images/search.png" Width="18" Height="18" Margin="10,0,0,0"
                               HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    </Grid>
                    
                    <Grid Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                BorderBrush="{StaticResource Ink}" BorderThickness="2" Margin="0,0,10,0">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <Border Grid.Column="1" Background="Gold" BorderBrush="{StaticResource Ink}"
                                BorderThickness="1" Padding="10,6"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PixelText}"/>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{Binding [ButtonAdd]}"
                                Style="{StaticResource PixelButton}"
                                Click="AddFriend_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="RequestsPanel" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
            <Border Background="{StaticResource Glacier}" BorderBrush="{StaticResource Ink}"
                    BorderThickness="2" Padding="16">
                <ItemsControl>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource Ink}"
                                    BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Source="/Resources/Images/person.png" Width="24" Height="24" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Username}"
                                                   Style="{StaticResource PixelText}" VerticalAlignment="Center" FontSize="16"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Style="{StaticResource PixelButton}"
                                            Background="#32CD32" Width="40" Height="40"
                                            Margin="0,0,10,0" Click="AcceptRequest_Click" Tag="{Binding}">
                                        <Image Source="/Resources/Images/check.png" Width="24" Height="24"/>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource PixelButtonDangerStyle}"
                                            Width="40" Height="40"
                                            Click="RejectRequest_Click" Tag="{Binding}">
                                        <Image Source="/Resources/Images/cross.png" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Grid>
</Window>

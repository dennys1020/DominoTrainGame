<Window
    x:Class="DominoTrainGame.Views.RecoverPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [RecoverPasswordWindowTitle]}"
    Width="460"
    Height="480"
    MinWidth="380"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    ShowInTaskbar="False">

    <Grid Margin="24">
        <Border Background="{StaticResource Glacier}" BorderBrush="{StaticResource Ink}"
                BorderThickness="2" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding [RecoverPasswordFormTitle]}"
                           Style="{StaticResource PixelText}" FontSize="20"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="{Binding [EmailOrUsernameLabel]}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailOrUsernameTextBox" Height="36" FontFamily="Consolas" FontSize="13"
                         Padding="8" Margin="0,0,0,16"/>

                <TextBlock Text="{Binding [NewPasswordLabel]}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="NewPasswordBox" Height="36" FontFamily="Consolas" FontSize="13"
                             Padding="8" Margin="0,0,0,16"/>

                <TextBlock Text="{Binding [ConfirmPasswordLabel]}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="36" FontFamily="Consolas" FontSize="13"
                             Padding="8" Margin="0,0,0,20"/>

                <Button Content="{Binding [ChangePasswordButtonLabel]}"
                        Style="{StaticResource PixelButton}"
                        Height="46" Click="ChangePassword_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

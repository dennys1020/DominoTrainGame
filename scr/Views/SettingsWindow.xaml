<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    x:Class="DominoTrainGame.Views.SettingsWindow"
    Title="{Binding [SettingsWindowTitle]}"
    Width="1220"
    Height="880"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    xmlns:strings="clr-namespace:DominoTrainGame.Resources.Localization"
    xmlns:resources="clr-namespace:DominoTrainGame.Resources"
    ShowInTaskbar="False">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="820" Margin="0" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid VerticalAlignment="Top" Margin="0,6,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource Glacier}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Canvas>
                                        <Path
                                            Fill="{StaticResource Ink}"
                                            Data="M5,5 H11 V11 H5 Z M19,5 H25 V11 H19 Z M0,16 H30 V19 H0 Z M12,25
                                                H18 V31 H12 Z" />
                                    </Canvas>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding [GameTitle]}"
                                    Style="{StaticResource PixelText}"
                                    FontSize="16" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border
                                Background="{StaticResource Frost}"
                                BorderBrush="{StaticResource Ink}"
                                BorderThickness="2"
                                Padding="12,9">
                                <TextBlock
                                    Text="{Binding [SettingsTitle]}"
                                    Style="{StaticResource PixelText}"
                                    FontSize="9" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="0,0,4,0">
                                    <Image Margin="0,364,0,0" Source="/Resources/Images/PixelTrain.png" Stretch="Fill"/>
                                </Border>

                                <Grid Grid.Column="1" Margin="36,28,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="74" />
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="116" />
                                        <RowDefinition Height="116" />
                                        <RowDefinition Height="54" />
                                        <RowDefinition Height="76" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [SettingsTitle]}"
                                            Style="{StaticResource PixelText}"
                                            FontSize="24"
                                            Margin="0,2,0,0" />
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock
                                            Text="{Binding [AudioSectionLabel]}"
                                            Style="{StaticResource SectionLabel}"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,18,0" />
                                        <Border
                                            Background="{StaticResource Mint}"
                                            Height="2"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid Grid.Row="2" Margin="0,6,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Ink}"
                                            BorderThickness="2"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                            <Path
                                                Fill="{StaticResource Ink}"
                                                Margin="8"
                                                Stretch="Uniform"
                                                Data="M8,0 H24 V5 H12 V21 H8 V25 H0 V17 H8 Z M20,5 H24 V17 H20 V21
                                                    H12 V13 H20 Z" />
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="{Binding [MusicVolumeLabel]}"
                                                Style="{StaticResource PixelText}"
                                                VerticalAlignment="Center" />
                                            <Border
                                                HorizontalAlignment="Right"
                                                Background="{StaticResource Mist}"
                                                Padding="9,5"
                                                Margin="0,-4,0,0">
                                                <TextBlock Style="{StaticResource PixelText}" FontSize="10">
                                                    <TextBlock.Text>
                                                        <Binding
                                                            Path="Value"
                                                            ElementName="_musicVolumeSlider"
                                                            StringFormat="{x:Static strings:UiStrings.VolumePercentageFormat}" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <Slider
                                                x:Name="_musicVolumeSlider"
                                                Value="{x:Static resources:SettingsDefaults.DefaultMusicVolume}"
                                                Style="{StaticResource PixelSlider}"
                                                Margin="0,24,0,22"
                                                Grid.RowSpan="3"
                                                x:FieldModifier="private" />
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="44"
                                            Height="44"
                                            Background="{StaticResource Mist}"
                                            BorderBrush="{StaticResource Ink}"
                                            BorderThickness="2"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                            <Path
                                                Fill="{StaticResource Ink}"
                                                Margin="8"
                                                Stretch="Uniform"
                                                Data="M0,8 H5 V4 H9 V0 H13 V24 H9 V20 H5 V16 H0 Z M17,6 H20 V18 H17
                                                    Z M22,2 H25 V22 H22 Z" />
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="36" />
                                                <RowDefinition Height="18" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Text="{Binding [SoundEffectsVolumeLabel]}"
                                                Style="{StaticResource PixelText}"
                                                VerticalAlignment="Center" />
                                            <Border
                                                HorizontalAlignment="Right"
                                                Background="{StaticResource Mist}"
                                                Padding="9,5"
                                                Margin="0,-4,0,0">
                                                <TextBlock Style="{StaticResource PixelText}" FontSize="10">
                                                    <TextBlock.Text>
                                                        <Binding
                                                            Path="Value"
                                                            ElementName="_soundEffectsVolumeSlider"
                                                            StringFormat="{x:Static
                                                                strings:UiStrings.VolumePercentageFormat}" />
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                            <Slider
                                                x:Name="_soundEffectsVolumeSlider"
                                                Grid.Row="1"
                                                Value="{x:Static resources:SettingsDefaults.DefaultSoundEffectsVolume}"
                                                Style="{StaticResource PixelSlider}"
                                                Margin="0,3,0,18"
                                                Grid.RowSpan="2"
                                                x:FieldModifier="private" />
                                        </Grid>
                                    </Grid>
                                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                                        <TextBlock
                                            Text="{Binding [LanguageSectionLabel]}"
                                            Style="{StaticResource SectionLabel}"
                                            DockPanel.Dock="Left"
                                            Margin="0,0,18,0" />
                                        <Border
                                            Background="{StaticResource Mint}"
                                            Height="2"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            GroupName="Language"
                                            IsChecked="{Binding IsSpanishSelected, Mode=TwoWay}"
                                            Style="{StaticResource LanguageOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="40"
                                                    Height="40"
                                                    Background="{StaticResource Glacier}"
                                                    BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="2"
                                                    Margin="0,0,14,0">
                                                    <TextBlock
                                                        Text="{Binding [SpanishLanguageCode]}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="10"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding [SpanishLanguageName]}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="11" />
                                                    <TextBlock
                                                        Text="{Binding [SpanishLanguageDescription]}"
                                                        FontSize="13"
                                                        Margin="0,7,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            Grid.Column="2"
                                            GroupName="Language"
                                            IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"
                                            Style="{StaticResource LanguageOption}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="40"
                                                    Height="40"
                                                    Background="{StaticResource Glacier}"
                                                    BorderBrush="{StaticResource Ink}"
                                                    BorderThickness="2"
                                                    Margin="0,0,14,0">
                                                    <TextBlock
                                                        Text="{Binding [EnglishLanguageCode]}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="10"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding [EnglishLanguageName]}"
                                                        Style="{StaticResource PixelText}"
                                                        FontSize="11" />
                                                    <TextBlock
                                                        Text="{Binding [EnglishLanguageDescription]}"
                                                        FontSize="13"
                                                        Margin="0,7,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                    <Grid Grid.Row="6" Margin="0,26,0,0">
                                        <Grid VerticalAlignment="Bottom">
                                            <Button
                                                Content="{Binding [BackButtonLabel]}"
                                                Style="{StaticResource PixelButton}"
                                                HorizontalAlignment="Left"
                                                Width="154"
                                                Height="50"
                                                IsCancel="True"
                                                Click="CloseSettings" />
                                            <Button
                                                Content="{Binding [SaveButtonLabel]}"
                                                Style="{StaticResource PixelButton}"
                                                HorizontalAlignment="Right"
                                                Width="188"
                                                Height="50"
                                                Background="{StaticResource Ink}"
                                                Foreground="{StaticResource Glacier}"
                                                Click="CloseSettings" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

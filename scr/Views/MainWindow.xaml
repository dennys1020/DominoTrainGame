                    <GeometryDrawing Brush="{StaticResource Mint}"
                        Geometry="M110,480 H126 V590 H110 Z M1048,472 H1064 V594 H1048 Z" />
                    <GeometryDrawing Brush="{StaticResource Seafoam}"
                        Geometry="M90,472 H104 V452 H130 V472 H146 V502 H90 Z M1026,456 H1040 V436 H1072 V456 H1090 V490 H1026 Z" />
                    <GeometryDrawing Brush="{StaticResource Mist}" Geometry="M0,636 H1200 V740 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource Seafoam}" Geometry="M0,636 H1200 V640 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource Mint}"
                        Geometry="M0,594 H1200 V602 H0 Z M0,616 H1200 V623 H0 Z M22,600 H34 V634 H22 Z M82,600 H94 V634 H82 Z M142,600 H154 V634 H142 Z M202,600 H214 V634 H202 Z M262,600 H274 V634 H262 Z M322,600 H334 V634 H322 Z M382,600 H394 V634 H382 Z M442,600 H454 V634 H442 Z M502,600 H514 V634 H502 Z M562,600 H574 V634 H562 Z M622,600 H634 V634 H622 Z M682,600 H694 V634 H682 Z M742,600 H754 V634 H742 Z M802,600 H814 V634 H802 Z M862,600 H874 V634 H862 Z M922,600 H934 V634 H922 Z M982,600 H994 V634 H982 Z M1042,600 H1054 V634 H1042 Z M1102,600 H1114 V634 H1102 Z M1162,600 H1174 V634 H1162 Z" />
                    <GeometryDrawing Brush="{StaticResource Mint}"
                        Geometry="M68,676 H100 V680 H68 Z M112,686 H124 V690 H112 Z M296,702 H322 V706 H296 Z M880,694 H914 V698 H880 Z M1094,672 H1126 V676 H1094 Z M1048,706 H1062 V710 H1048 Z" />
                    <GeometryDrawing Brush="{StaticResource Seafoam}" Geometry="M0,732 H1200 V740 H0 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <Grid Background="{StaticResource Glacier}">
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.06"
                   IsHitTestVisible="False" />

        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="740" ClipToBounds="True">
                <Image Source="{StaticResource MenuLandscapeImage}"
                   Width="1200" Height="740" IsHitTestVisible="False" />

                <Canvas IsHitTestVisible="False">
                    <Image Canvas.Left="140" Canvas.Top="342" Width="78" Height="140"
                       Source="{StaticResource MenuDominoImage}" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <RotateTransform Angle="-14" />
                        </Image.RenderTransform>
                    </Image>
                    <Image Canvas.Left="990" Canvas.Top="282" Width="91" Height="164"
                       Source="{StaticResource MenuDominoImage}" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <RotateTransform Angle="14" />
                        </Image.RenderTransform>
                    </Image>
                    <Path Canvas.Left="250" Canvas.Top="298" Fill="{StaticResource Seafoam}"
                      Data="M8,0 H12 V8 H20 V12 H12 V20 H8 V12 H0 V8 H8 Z" />
                    <Path Canvas.Left="918" Canvas.Top="222" Fill="{StaticResource Aqua}"
                      Data="M8,0 H12 V8 H20 V12 H12 V20 H8 V12 H0 V8 H8 Z" />
                    <Rectangle Canvas.Left="1076" Canvas.Top="166" Width="8" Height="8" Fill="{StaticResource Mint}" />
                    <Rectangle Canvas.Left="216" Canvas.Top="256" Width="8" Height="8" Fill="{StaticResource Mint}" />
                </Canvas>

                <StackPanel Margin="32,32,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Button Style="{StaticResource MenuIconButton}" Margin="0,0,0,14"
                        Click="OpenProfile"
                        ToolTip="{Binding [OpenProfileButtonLabel]}">
                        <Image Width="41" Height="43" Stretch="Uniform"
                           Source="/Resources/Images/avatar_generic_preview.png"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Button>

                    <Button Style="{StaticResource MenuIconButton}" Margin="0,0,0,14"
                        Click="OpenFriendsList"
                        ToolTip="{Binding [OpenFriendsListLabel]}">
                        <Image Width="36" Height="36" Source="{StaticResource MenuFriendsImage}" />
                    </Button>

                    <controls:SettingsButton />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,32,0">
                    <Button Content="{Binding [GameRulesButtonLabel]}" Click="OpenRules"
                            Style="{StaticResource PixelButton}" FontSize="9"
                            Width="222" Height="50" Margin="0,0,0,12" />
                    <Button Content="{Binding [ViewScoresButtonLabel]}" Click="OpenResults"
                            Style="{StaticResource PixelButton}" FontSize="9"
                            Width="222" Height="50" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,100,0,0">
                    <Grid Height="66">
                        <TextBlock Text="{Binding [GameTitle]}" Margin="5,5,0,0"
                               Style="{StaticResource PixelText}" FontSize="48"
                               Foreground="{StaticResource Mint}" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding [GameTitle]}"
                               Style="{StaticResource PixelText}" FontSize="48" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,38">
                        <Rectangle Width="40" Height="6" Fill="{StaticResource Mint}" Margin="0,0,8,0" />
                        <Rectangle Width="40" Height="6" Fill="{StaticResource Seafoam}" Margin="0,0,8,0" />
                        <Rectangle Width="40" Height="6" Fill="{StaticResource Aqua}" />
                    </StackPanel>

                    <Button Content="{Binding [ButtonPlay]}"
                        Click="OpenNewGame"
                        Style="{StaticResource PixelButton}"
                        Background="{StaticResource Aqua}" FontSize="18"
                        Width="380" Height="76" Margin="0,0,0,16" />

                    <Button Content="{Binding [ButtonExit]}"
                        Style="{StaticResource PixelButton}"
                        Background="{StaticResource Mist}" FontSize="13"
                        Width="380" Height="58" />
                </StackPanel>

                <Image Source="{StaticResource MenuTrainImage}"
                       Width="660" Height="228.8" Margin="0,404,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       IsHitTestVisible="False" />
            </Grid>
        </Viewbox>
    </Grid>
</Window>

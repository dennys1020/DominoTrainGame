                    <GeometryDrawing Brush="{StaticResource Aqua}"
                        Geometry="M8,7 H12 V9 H13 V12 H11 V13 H8 V11 H7 V9 H8 Z M5,23 H15 V26 H5 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="MenuTrainImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H300 V104 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource Mist}"
                        Geometry="M26,10 H48 V18 H26 Z M50,1 H80 V9 H50 Z" />
                    <GeometryDrawing Brush="{StaticResource Ink}"
                        Geometry="M24,28 H42 V46 H56 V24 H92 V66 H101 V77 H9 V65 H17 V46 H27 V35 H24 Z" />
                    <GeometryDrawing Brush="{StaticResource Aqua}" Geometry="M21,50 H58 V65 H21 Z M60,28 H88 V65 H60 Z" />
                    <GeometryDrawing Brush="{StaticResource Glacier}" Geometry="M65,34 H82 V49 H65 Z" />
                    <GeometryDrawing Brush="{StaticResource Seafoam}" Geometry="M13,69 H95 V73 H13 Z" />
                    <GeometryDrawing Brush="{StaticResource Ink}" Geometry="M101,67 H115 V71 H101 Z M179,67 H193 V71 H179 Z M113,67 H181 V77 H113 Z M191,67 H259 V77 H191 Z" />
                    <GeometryDrawing Brush="{StaticResource Frost}" Geometry="M117,70 H177 V73 H117 Z M195,70 H255 V73 H195 Z" />
                    <GeometryDrawing Brush="{StaticResource Ink}" Geometry="M120,15 H174 V67 H120 Z M198,15 H252 V67 H198 Z" />
                    <GeometryDrawing Brush="{StaticResource Glacier}" Geometry="M124,19 H170 V63 H124 Z M202,19 H248 V63 H202 Z" />
                    <GeometryDrawing Brush="{StaticResource Mint}" Geometry="M126,39 H168 V42 H126 Z M204,39 H246 V42 H204 Z" />
                    <GeometryDrawing Brush="{StaticResource Ink}"
                        Geometry="M129,23 H134 V28 H129 Z M160,31 H165 V36 H160 Z M129,46 H134 V51 H129 Z M145,51 H150 V56 H145 Z M160,56 H165 V61 H160 Z M209,24 H214 V29 H209 Z M236,24 H241 V29 H236 Z M209,31 H214 V36 H209 Z M236,31 H241 V36 H236 Z M222,50 H228 V56 H222 Z" />
                    <GeometryDrawing Brush="{StaticResource Ink}"
                        Geometry="M25,74 H41 V87 H25 Z M68,74 H84 V87 H68 Z M123,74 H139 V87 H123 Z M155,74 H171 V87 H155 Z M201,74 H217 V87 H201 Z M233,74 H249 V87 H233 Z" />
                    <GeometryDrawing Brush="{StaticResource Seafoam}"
                        Geometry="M30,78 H36 V83 H30 Z M73,78 H79 V83 H73 Z M128,78 H134 V83 H128 Z M160,78 H166 V83 H160 Z M206,78 H212 V83 H206 Z M238,78 H244 V83 H238 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="MenuDominoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource Mint}" Geometry="M5,5 H65 V117 H5 Z" />
                    <GeometryDrawing Brush="{StaticResource Ink}" Geometry="M0,0 H60 V112 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource Glacier}" Geometry="M4,4 H56 V108 H4 Z" />
                    <GeometryDrawing Brush="{StaticResource Mint}" Geometry="M9,54 H51 V58 H9 Z" />
                    <GeometryDrawing Brush="{StaticResource Ink}"
                        Geometry="M13,14 H21 V22 H13 Z M39,36 H47 V44 H39 Z M13,70 H21 V78 H13 Z M39,70 H47 V78 H39 Z M26,83 H34 V91 H26 Z M13,96 H21 V104 H13 Z M39,96 H47 V104 H39 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="MenuLandscapeImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H1200 V740 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource Mist}"
                        Geometry="M150,162 H178 V148 H210 V158 H240 V176 H150 Z M900,120 H925 V105 H970 V116 H997 V134 H900 Z M1050,228 H1074 V210 H1106 V220 H1136 V240 H1050 Z M196,444 H216 V430 H246 V438 H268 V455 H196 Z" />

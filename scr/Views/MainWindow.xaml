<Window
    x:Class="DominoTrainGame.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    xmlns:controls="clr-namespace:DominoTrainGame.Views.Controls"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [MainWindowTitle]}"
    Width="1220"
    Height="800"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource Glacier}"
    UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <DrawingImage x:Key="MenuFriendsImage">

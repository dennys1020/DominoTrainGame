<Window
    x:Class="DominoTrainGame.Views.ChangePasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [ChangePasswordWindowTitle]}"
    Width="1220"
    Height="880"
    MinWidth="960"
    MinHeight="700"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource Mist}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    ShowInTaskbar="False"
    FocusManager.FocusedElement="{Binding ElementName=_currentPasswordBox}">
    <Window.Resources>
        <Style x:Key="PasswordField" TargetType="PasswordBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Frost}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border
                            x:Name="FieldBorder"
                            Background="{StaticResource Mist}"
                            BorderBrush="{StaticResource Mint}"
                            BorderThickness="2"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="{StaticResource Glacier}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PasswordLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.42" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="820" TextOptions.TextFormattingMode="Display">
                <Grid Margin="48,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,6,8,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="46" Margin="0,0,16,0">
                                <Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
                                <Border
                                    Background="{StaticResource Glacier}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="3"
                                    Margin="0,0,4,4">
                                    <Path
                                        Fill="{StaticResource Ink}"
                                        Data="M5,5 H11 V11 H5 Z M19,5 H25 V11 H19 Z M0,16 H30 V19 H0 Z M12,25 H18 V31 H12 Z" />
                                </Border>
                            </Grid>
                            <TextBlock
                                Text="{Binding [GameTitle]}"
                                Style="{StaticResource PixelText}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Content="{Binding [OpenSettingsButtonLabel]}"
                            Style="{StaticResource PixelButton}"
                            Height="46"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="{Binding [OpenSettingsAccessibleName]}"
                            Click="OpenSettings" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border
                            Margin="0,0,8,8"
                            Background="{StaticResource Glacier}"
                            BorderBrush="{StaticResource Ink}"
                            BorderThickness="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="268" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="0,0,4,0">
                                    <Grid ClipToBounds="True">
                                        <StackPanel Margin="24,30,24,0" VerticalAlignment="Top">
                                            <Grid Width="80" Height="88" HorizontalAlignment="Left" Margin="0,30,0,24">
                                                <Path
                                                    Fill="{StaticResource Ink}"
                                                    RenderOptions.EdgeMode="Aliased"
                                                    Data="M20,0 H60 V8 H68 V36 H80 V88 H0 V36 H12 V8 H20 Z" />
                                                <Path
                                                    Fill="{StaticResource Glacier}"
                                                    RenderOptions.EdgeMode="Aliased"
                                                    Data="M28,12 H52 V20 H56 V36 H24 V20 H28 Z M8,44 H72 V80 H8 Z" />
                                                <Path
                                                    Fill="{StaticResource Ink}"
                                                    Data="M32,52 H48 V64 H44 V72 H36 V64 H32 Z" />
                                            </Grid>
                                        </StackPanel>
                                        <Image
                                            Source="pack://application:,,,/Resources/Images/PixelTrain.png"
                                            Height="242"
                                            Stretch="UniformToFill"
                                            VerticalAlignment="Top"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            IsHitTestVisible="False" Margin="0,394,0,0" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1" Margin="36,30,36,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="96" />
                                        <RowDefinition Height="288" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="54" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [ChangePasswordTitle]}"
                                            Style="{StaticResource PixelText}"
                                            FontSize="23" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock
                                            Text="{Binding [CurrentPasswordLabel]}"
                                            Style="{StaticResource PasswordLabel}" />
                                        <PasswordBox
                                            x:Name="_currentPasswordBox"
                                            x:FieldModifier="private"
                                            Style="{StaticResource PasswordField}"
                                            Margin="0,0,0,24" />
                                        <TextBlock
                                            Text="{Binding [NewPasswordLabel]}"
                                            Style="{StaticResource PasswordLabel}" />
                                        <PasswordBox
                                            x:Name="_newPasswordBox"
                                            x:FieldModifier="private"
                                            Style="{StaticResource PasswordField}"
                                            AutomationProperties.HelpText="{Binding [NewPasswordHint]}"
                                            Margin="0,0,0,24" />
                                        <TextBlock
                                            Text="{Binding [ConfirmPasswordLabel]}"
                                            Style="{StaticResource PasswordLabel}" />
                                        <PasswordBox
                                            x:Name="_confirmPasswordBox"
                                            x:FieldModifier="private"
                                            Style="{StaticResource PasswordField}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,4,0,16">
                                        <TextBlock
                                            Text="{Binding [NewPasswordHint]}"
                                            TextWrapping="Wrap"
                                            FontSize="14" />
                                    </StackPanel>
                                    <Grid Grid.Row="3">
                                        <Button
                                            Content="{Binding [BackButtonLabel]}"
                                            Style="{StaticResource PixelButton}"
                                            Width="154"
                                            HorizontalAlignment="Left"
                                            IsCancel="True"
                                            Click="GoBack" />
                                        <Button
                                            Content="{Binding [UpdatePasswordButtonLabel]}"
                                            Style="{StaticResource PixelButton}"
                                            Background="{StaticResource Ink}"
                                            Foreground="{StaticResource Glacier}"
                                            Width="248"
                                            HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="2"
                        Text="{Binding [PasswordPrivacyNote]}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Margin="0,0,8,0" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

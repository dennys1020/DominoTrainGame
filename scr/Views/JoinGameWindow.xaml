<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DominoTrainGame.Views.Controls"
    xmlns:viewModels="clr-namespace:DominoTrainGame.ViewModels"
    x:Class="DominoTrainGame.Views.JoinGameWindow"
    DataContext="{x:Static viewModels:LocalizationViewModel.Instance}"
    Title="{Binding [JoinGameWindowTitle]}"
    Style="{StaticResource MatchWindow}"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Rectangle Fill="{StaticResource GridPattern}" Opacity="0.22" IsHitTestVisible="False" />
        <Viewbox Stretch="Uniform">
            <Grid Width="1200" Height="800">
                <Grid Margin="40,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image
                                Source="{StaticResource MatchDominoImage}"
                                Width="24"
                                Height="42"
                                Margin="0,0,16,0" />
                            <TextBlock
                                Text="{Binding [GameTitle]}"
                                Style="{StaticResource PixelText}"
                                FontSize="16"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:SettingsButton HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,8,0,16">
                        <Border Background="{StaticResource Ink}" Margin="8,8,0,0" />
                        <Border Style="{StaticResource MatchCard}" Margin="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{StaticResource Aqua}"
                                    BorderBrush="{StaticResource Ink}"
                                    BorderThickness="2"
                                    Padding="28">
                                    <StackPanel VerticalAlignment="Center">
                                        <Image
                                            Source="{StaticResource MatchDominoImage}"
                                            Width="78"
                                            Height="138"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,36" />
                                        <TextBlock
                                            Text="{Binding [JoinSidebarTitle]}"
                                            Style="{StaticResource MatchHeading}"
                                            FontSize="19" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Column="1" Margin="40,20,12,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="60" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            Text="{Binding [InvitationTitle]}"
                                            Style="{StaticResource MatchHeading}" />
                                        <TextBlock
                                            Text="{Binding [InvitationDescription]}"
                                            Style="{StaticResource MatchBody}"
                                            Margin="0,18,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,26,0,26">
                                        <TextBlock
                                            Text="{Binding [InvitationCodeLabel]}"
                                            Style="{StaticResource MatchSection}" />
                                        <TextBox
                                            Style="{StaticResource MatchInput}"
                                            MinHeight="82"
                                            AutomationProperties.Name="{Binding [InvitationCodeLabel]}"
                                            ToolTip="{Binding [InvitationCodeHint]}" />
                                    </StackPanel>
                                    <Button
                                        Content="{Binding [JoinRoomButtonLabel]}"
                                        Style="{StaticResource MatchButton}"
                                        Click="OpenWaitingRoom"
                                        Grid.Row="2"
                                        Background="{StaticResource Aqua}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,8,4">
                        <Button
                            Content="{Binding [BackButtonLabel]}"
                            Style="{StaticResource MatchButton}"
                            Click="NavigateBack"
                            HorizontalAlignment="Left"
                            MinWidth="170" />
                        <Button
                            Content="{Binding [GameRulesButtonLabel]}"
                            Style="{StaticResource MatchButton}"
                            Click="OpenRules"
                            HorizontalAlignment="Right"
                            MinWidth="210" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>

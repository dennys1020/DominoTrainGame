<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <clear />
  <!-- Elige Local o Companero. Reinicia la aplicacion despues de cambiarlo. -->
  <add name="ActiveDatabase" connectionString="Local" />
  <!-- Perfil Local: este nombre tambien mantiene la compatibilidad con el modelo de Entity Framework. -->
  <add name="DominoGameDBEntities"
       providerName="System.Data.EntityClient"
       connectionString="metadata=res://*/Server.Data.EntityFramework.DominoGameModel.csdl|res://*/Server.Data.EntityFramework.DominoGameModel.ssdl|res://*/Server.Data.EntityFramework.DominoGameModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=localhost\SQLEXPRESS;initial catalog=DominoGameDB;user id=domino_rw_user;password=CONFIGURA_PASSWORD_LOCAL;encrypt=True;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" />
  <!-- Completa el servidor y la autenticacion del segundo perfil en Database.config. -->
  <add name="Companero"
       providerName="System.Data.EntityClient"
       connectionString="metadata=res://*/Server.Data.EntityFramework.DominoGameModel.csdl|res://*/Server.Data.EntityFramework.DominoGameModel.ssdl|res://*/Server.Data.EntityFramework.DominoGameModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=SERVIDOR\INSTANCIA;initial catalog=DominoGameDB;user id=domino_rw_user;password=CONFIGURA_PASSWORD_LOCAL;encrypt=True;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" />
</connectionStrings>
